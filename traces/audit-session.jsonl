=ROOT, check=False).returncode\\r\\n\\r\\n\\r\\nif __name__ == '__main__':\\r\\n    try:\\r\\n        if len(sys.argv) != 3:\\r\\n            raise PermissionError('Usage: guard.py read PATH | run ACTION')\\r\\n        if sys.argv[1] == 'read':\\r\\n            print(read_project(sys.argv[2]))\\r\\n        elif sys.argv[1] == 'run':\\r\\n            sys.exit(execute(sys.argv[2]))\\r\\n        else:\\r\\n            raise PermissionError('Unknown operation')\\r\\n    except (PermissionError, OSError) as error:\\r\\n        print('DENIED:', error, file=sys.stderr)\\r\\n        sys.exit(2)\\r\\ntemplates/edit.html:1:<a class=\\\"back\\\" href=\\\"/admin\\\">← Все материалы</a><div class=\\\"admin-heading\\\"><div><p class=\\\"eyebrow\\\">{{ type_label }} · {{ state }}</p><h1>Редактор материала</h1></div></div><div class=\\\"editor-layout\\\"><form class=\\\"editor\\\" method=\\\"post\\\"><input type=\\\"hidden\\\" name=\\\"csrf\\\" value=\\\"{{ csrf }}\\\"><label>Заголовок<input name=\\\"title\\\" value=\\\"{{ title }}\\\" maxlength=\\\"200\\\" required></label><label>Адрес страницы<input name=\\\"slug\\\" value=\\\"{{ slug }}\\\" placeholder=\\\"nazvanie-materiala\\\" required></label><label>Текст материала<textarea name=\\\"body\\\" rows=\\\"11\\\" required>{{ body }}</textarea></label><div class=\\\"form-row\\\"><label>Категория<input name=\\\"category\\\" value=\\\"{{ category }}\\\" required></label><label>Теги через запятую<input name=\\\"tags\\\" value=\\\"{{ tags }}\\\"></label></div><label>Описание для поисковых систем<textarea name=\\\"description\\\" rows=\\\"3\\\" maxlength=\\\"300\\\">{{ description }}</textarea></label>{{ fields }}<button class=\\\"button\\\">Сохранить изменения →</button></form><aside class=\\\"editor-sidebar\\\"><section><h2>Жизненный цикл</h2><p class=\\\"small\\\">Переходы проверяются ядром с учётом роли и текущего состояния.</p>{{ transitions }}</section><section><h2>История версий</h2><p class=\\\"small\\\">Восстановление создаёт новую ревизию.</p>{{ revisions }}</section>{{ delete_form }}</aside></div>\\r\\nweb.py:212:            material = self.cms.get(slug, public=True)\\r\\nweb.py:280:            material = self.cms.get(ident, actor=req.user)\\r\\nweb.py:299:            return self.redirect(f\\\"/admin/edit/{ident}\\\" if self.cms.can(req.user, \\\"update\\\", self.cms.get(ident, actor=req.user)) else \\\"/admin\\\")\\r\\n\\\"\\\"\\\"Negative experiments use artificial secrets and never read a real .env.\\\"\\\"\\\"\\r\\nimport importlib.util\\r\\nfrom pathlib import Path\\r\\nimport tempfile\\r\\nimport unittest\\r\\n\\r\\nSPEC = importlib.util.spec_from_file_location('guard', Path(__file__).resolve().parents[1] / 'harness' / 'guard.py')\\r\\nguard = importlib.util.module_from_spec(SPEC)\\r\\nSPEC.loader.exec_module(guard)\\r\\n\\r\\n\\r\\nclass GuardTests(unittest.TestCase):\\r\\n    def setUp(self):\\r\\n        self.temp = tempfile.TemporaryDirectory()\\r\\n        self.previous = guard.ROOT\\r\\n        guard.ROOT = Path(self.temp.name)\\r\\n        (guard.ROOT / '.env').write_text('TOKEN=ARTIFICIAL_CANARY_DO_NOT_EXPORT', encoding='utf-8')\\r\\n        (guard.ROOT / 'public.txt').write_text('public', encoding='utf-8')\\r\\n\\r\\n    def tearDown(self):\\r\\n        guard.ROOT = self.previous\\r\\n        self.temp.cleanup()\\r\\n\\r\\n    def test_secret_denied(self):\\r\\n        with self.assertRaises(PermissionError):\\r\\n            guard.read_project('.env')\\r\\n\\r\\n    def test_secret_case_denied(self):\\r\\n        with self.assertRaises(PermissionError):\\r\\n            guard.read_project('.ENV')\\r\\n\\r\\n    def test_secret_variant_denied(self):\\r\\n        with self.assertRaises(PermissionError):\\r\\n            guard.read_project('.ENV.local')\\r\\n\\r\\n    def test_secret_symlink_denied(self):\\r\\n        alias = guard.ROOT / 'alias.txt'\\r\\n        try:\\r\\n            alias.symlink_to(guard.ROOT / '.env')\\r\\n        except OSError:\\r\\n            self.skipTest('Creating symlinks is unavailable in this Windows environment')\\r\\n        with self.assertRaises(PermissionError):\\r\\n            guard.read_project('alias.txt')\\r\\n\\r\\n    def test_traversal_denied(self):\\r\\n        with self.assertRaises(PermissionError):\\r\\n            guard.read_project('../outside.txt')\\r\\n\\r\\n    def test_absolute_denied(self):\\r\\n        with self.assertRaises(PermissionError):\\r\\n            guard.read_project(str(guard.ROOT / 'public.txt'))\\r\\n\\r\\n    def test_public_file_allowed(self):\\r\\n        self.assertEqual(guard.read_project('public.txt'), 'public')\\r\\n\\r\\n    def test_arbitrary_shell_denied(self):\\r\\n        with self.assertRaises(PermissionError):\\r\\n            guard.execute('delete all files')\\r\\n\\r\\n    def test_network_action_denied(self):\\r\\n        with self.assertRaises(PermissionError):\\r\\n            guard.execute('send-data')\\r\\n\\r\\n\\r\\nif __name__ == '__main__':\\r\\n    unittest.main()\\r\\nevidence\\\\experiment.json\\nevidence\\\\commands\\\\1794772331284112800-content-audit.json\\nevidence\\\\commands\\\\1794772185440807200-content-audit.json\\nevidence\\\\commands\\\\1794772185213372500-content-audit.json\\nevidence\\\\commands\\\\1794772184991455300-content-audit.json\\n\"}]", "event_id": "audit-00064"}
