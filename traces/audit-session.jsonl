, published_at, now(), material_id))\\ncore.py:478:                    self._audit(actor, \\\"material.transition\\\", material_id, \\\"bulk:\\\" + operation)\\nweb.py:75:    def get(self, name, default=\\\"\\\"):\\nweb.py:87:    def __init__(self, cms, root=None, base_url=\\\"http://localhost:8080\\\"):\\nweb.py:196:            return 200, [(\\\"Content-Type\\\", \\\"text/plain; charset=utf-8\\\")], \\\"User-agent: *\\\\nAllow: /\\\\nDisallow: /admin\\\\nDisallow: /login\\\\nSitemap: /sitemap.xml\\\\n\\\"\\nweb.py:197:        if req.path == \\\"/sitemap.xml\\\":\\nweb.py:198:            result = self.cms.list(public=True, page_size=100)\\nweb.py:201:                items.extend(self.cms.list(public=True, page_size=100, page=page)[\\\"items\\\"])\\nweb.py:203:            return 200, [(\\\"Content-Type\\\", \\\"application/xml; charset=utf-8\\\")], '<?xml version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"?><urlset xmlns=\\\"http://www.sitemaps.org/schemas/sitemap/0.9\\\">' + \\\"\\\".join(\\\"<url><loc>\\\" + html.escape(self.base_url + link) + \\\"</loc></url>\\\" for link in links) + \\\"</urlset>\\\"\\nweb.py:264:            self.cms.bulk(ids, req.post(\\\"operation\\\"), req.user)\\nweb.py:330:                operation = {\\\"draft\\\":\\\"draft\\\",\\\"review\\\":\\\"review\\\",\\\"published\\\":\\\"publish\\\",\\\"archived\\\":\\\"archive\\\"}[state]\\nweb.py:331:                if state in self.cms.TRANSITIONS[item[\\\"status\\\"]] and self.cms.can(req.user, operation, item):\\n.\\\\CHANGELOG.md\\n.\\\\AGENTS.md\\n.\\\\decisions\\\\ADR-003-rendering.md\\n.\\\\decisions\\\\ADR-002-core.md\\n.\\\\decisions\\\\ADR-001-agent.md\\n.\\\\harness\\\\history.md\\n.\\\\harness\\\\review.md\\n.\\\\harness\\\\commands.md\\n.\\\\harness\\\\context.md\\n.\\\\spec\\\\TEMPLATE.md\\n.\\\\spec\\\\03-harness.md\\n.\\\\spec\\\\02-web.md\\n.\\\\spec\\\\01-core.md\\n.\\\\spec\\\\00-project.md\\n.\\\\harness\\\\experiment\\\\README.md\\n\"}]", "event_id": "audit-00048"}
