{"timestamp": "2026-11-15T19:48:51.046Z", "kind": "custom_tool_call_output", "call_id": "C0013", "output": "[{\"type\": \"input_text\", \"text\": \"Script completed\\nWall time 0.7 seconds\\nOutput:\\n\"}, {\"type\": \"input_text\", \"text\": \"{\\\"i\\\":0,\\\"status\\\":\\\"fulfilled\\\",\\\"value\\\":{\\\"chunk_id\\\":\\\"fdd24d\\\",\\\"wall_time_seconds\\\":0.4525959,\\\"exit_code\\\":0,\\\"original_token_count\\\":3892,\\\"output\\\":\\\"                \\\\\\\"page_size\\\\\\\": page_size, \\\\\\\"pages\\\\\\\": (total + page_size - 1) // page_size}\\\\r\\\\n\\\\r\\\\n    def _audit(self, actor, operation, material_id, detail):\\\\r\\\\n        self.conn.execute(\\\\r\\\\n            \\\\\\\"INSERT INTO audit(actor_id,operation,material_id,detail,created_at) VALUES(?,?,?,?,?)\\\\\\\",\\\\r\\\\n            (actor[\\\\\\\"id\\\\\\\"] if actor else None, operation, material_id, detail, now()),\\\\r\\\\n        )\\\\r\\\\n\\\\r\\\\n    def _revision(self, material_id, actor):\\\\r\\\\n        item = self._existing(material_id)\\\\r\\\\n        self.conn.execute(\\\\r\\\\n            \\\\\\\"INSERT INTO revisions(material_id,number,snapshot,actor_id,created_at) VALUES(?,?,?,?,?)\\\\\\\",\\\\r\\\\n            (material_id, item[\\\\\\\"revision\\\\\\\"], json.dumps(item, ensure_ascii=False), actor[\\\\\\\"id\\\\\\\"], now()),\\\\r\\\\n        )\\\\r\\\\n\\\\r\\\\n    def create(self, data, actor):\\\\r\\\\n        data = self._validate(data)\\\\r\\\\n        self._require(actor, \\\\\\\"create\\\\\\\", type_name=data[\\\\\\\"type\\\\\\\"])\\\\r\\\\n        timestamp = now()\\\\r\\\\n        try:\\\\r\\\\n            with self.conn:\\\\r\\\\n                cursor = self.conn.execute(\\\\r\\\\n                    \\\\\\\"INSERT INTO materials(type,title,slug,body,description,fields_json,status,author_id,created_at,updated_at) \\\\\\\"\\\\r\\\\n                    \\\\\\\"VALUES(?,?,?,?,?,?,'draft',?,?,?)\\\\\\\",\\\\r\\\\n                    (data[\\\\\\\"type\\\\\\\"], data[\\\\\\\"title\\\\\\\"], data[\\\\\\\"slug\\\\\\\"], data[\\\\\\\"body\\\\\\\"], data[\\\\\\\"description\\\\\\\"],\\\\r\\\\n                     json.dumps(data[\\\\\\\"fields\\\\\\\"], ensure_ascii=False), actor[\\\\\\\"id\\\\\\\"], timestamp, timestamp),\\\\r\\\\n                )\\\\r\\\\n                material_id = cursor.lastrowid\\\\r\\\\n                self._terms(material_id, data[\\\\\\\"category\\\\\\\"], data[\\\\\\\"tags\\\\\\\"])\\\\r\\\\n                self._revision(material_id, actor)\\\\r\\\\n                self._audit(actor, \\\\\\\"material.create\\\\\\\", material_id, data[\\\\\\\"type\\\\\\\"])\\\\r\\\\n        except sqlite3.IntegrityError as exc:\\\\r\\\\n            raise ValueError(\\\\\\\"Адрес материала уже занят\\\\\\\") from exc\\\\r\\\\n        return self.get(material_id)\\\\r\\\\n\\\\r\\\\n    def update(self, material_id, data, actor):\\\\r\\\\n        item = self._existing(material_id)\\\\r\\\\n        self._require(actor, \\\\\\\"update\\\\\\\", item)\\\\r\\\\n        data = self._validate(data, item)\\\\r\\\\n        try:\\\\r\\\\n            with self.conn:\\\\r\\\\n                self._update_fields(material_id, data)\\\\r\\\\n                self._revision(material_id, actor)\\\\r\\\\n                self._audit(actor, \\\\\\\"material.update\\\\\\\", material_id, \\\\\\\"\\\\\\\")\\\\r\\\\n        except sqlite3.IntegrityError as exc:\\\\r\\\\n            raise ValueError(\\\\\\\"Адрес материала уже занят\\\\\\\") from exc\\\\r\\\\n        return self.get(material_id)\\\\r\\\\n\\\\r\\\\n    def _update_fields(self, material_id, data):\\\\r\\\\n        self.conn.execute(\\\\r\\\\n            \\\\\\\"UPDATE materials SET title=?,slug=?,body=?,description=?,fields_json=?,revision=revision+1,updated_at=? WHERE id=?\\\\\\\",\\\\r\\\\n            (data[\\\\\\\"title\\\\\\\"], data[\\\\\\\"slug\\\\\\\"], data[\\\\\\\"body\\\\\\\"], data[\\\\\\\"description\\\\\\\"], json.dumps(data[\\\\\\\"fields\\\\\\\"], ensure_ascii=False), now(), material_id),\\\\r\\\\n        )\\\\r\\\\n        self._terms(material_id, data[\\\\\\\"category\\\\\\\"], data[\\\\\\\"tags\\\\\\\"])\\\\r\\\\n\\\\r\\\\n    def transition(self, material_id, status, actor):\\\\r\\\\n        item = self._existing(material_id)\\\\r\\\\n        if status not in self.TRANSITIONS[item[\\\\\\\"status\\\\\\\"]]:\\\\r\\\\n            raise ValueError(\\\\\\\"Недопустимый переход состояния\\\\\\\")\\\\r\\\\n        operation = {\\\\\\\"review\\\\\\\": \\\\\\\"review\\\\\\\", \\\\\\\"published\\\\\\\": \\\\\\\"publish\\\\\\\", \\\\\\\"archived\\\\\\\": \\\\\\\"archive\\\\\\\", \\\\\\\"draft\\\\\\\": \\\\\\\"draft\\\\\\\"}[status]\\\\r\\\\n        self._require(actor, operation, item)\\\\r\\\\n        with self.conn:\\\\r\\\\n            published_at = now() if status == \\\\\\\"published\\\\\\\" and not item[\\\\\\\"published_at\\\\\\\"] else item[\\\\\\\"published_at\\\\\\\"]\\\\r\\\\n            self.conn.execute(\\\\r\\\\n                \\\\\\\"UPDATE materials SET status=?,published_at=?,revision=revision+1,updated_at=? WHERE id=?\\\\\\\",\\\\r\\\\n                (status, published_at, now(), material_id),\\\\r\\\\n            )\\\\r\\\\n            self._revision(material_id, actor)\\\\r\\\\n            self._audit(actor, \\\\\\\"material.transition\\\\\\\", material_id, f\\\\\\\"{item['status']} -> {status}\\\\\\\")\\\\r\\\\n        return self.get(material_id)\\\\r\\\\n\\\\r\\\\n    def revisions(self, material_id, actor):\\\\r\\\\n        item = self._existing(material_id)\\\\r\\\\n        self._require(actor, \\\\\\\"read\\\\\\\", item)\\\\r\\\\n        rows = self.conn.execute(\\\\\\\"SELECT * FROM revisions WHERE material_id=? ORDER BY number DESC\\\\\\\", (material_id,))\\\\r\\\\n        return [dict(r) | {\\\\\\\"snapshot\\\\\\\": json.loads(r[\\\\\\\"snapshot\\\\\\\"])} for r in rows]\\\\r\\\\n\\\\r\\\\n    def restore(self, material_id, revision_id, actor):\\\\r\\\\n        item = self._existing(material_id)\\\\r\\\\n        self._require(actor, \\\\\\\"restore\\\\\\\", item)\\\\r\\\\n        row = self.conn.execute(\\\\\\\"SELECT snapshot FROM revisions WHERE id=? AND material_id=?\\\\\\\", (revision_id, material_id)).fetchone()\\\\r\\\\n        if not row:\\\\r\\\\n            raise LookupError(\\\\\\\"Ревизия не найдена\\\\\\\")\\\\r\\\\n        previous = json.loads(row[\\\\\\\"snapshot\\\\\\\"])\\\\r\\\\n        data = self._validate({k: previous[k] for k in [\\\\\\\"type\\\\\\\", \\\\\\\"title\\\\\\\", \\\\\\\"slug\\\\\\\", \\\\\\\"body\\\\\\\", \\\\\\\"description\\\\\\\", \\\\\\\"category\\\\\\\", \\\\\\\"tags\\\\\\\", \\\\\\\"fields\\\\\\\"]}, item)\\\\r\\\\n        try:\\\\r\\\\n            with self.conn:\\\\r\\\\n                self._update_fields(material_id, data)\\\\r\\\\n                # Restoring historical text never resurrects publication or rewrites authorship.\\\\r\\\\n                self.conn.execute(\\\\\\\"UPDATE materials SET status='draft' WHERE id=?\\\\\\\", (material_id,))\\\\r\\\\n                self._revision(material_id, actor)\\\\r\\\\n                self._audit(actor, \\\\\\\"material.restore\\\\\\\", material_id, str(revision_id))\\\\r\\\\n        except sqlite3.IntegrityError as exc:\\\\r\\\\n            raise ValueError(\\\\\\\"Исторический адрес уже занят\\\\\\\") from exc\\\\r\\\\n        return self.get(material_id)\\\\r\\\\n\\\\r\\\\n    def delete(self, material_id, actor):\\\\r\\\\n        item = self._existing(material_id)\\\\r\\\\n        self._require(actor, \\\\\\\"delete\\\\\\\", item)\\\\r\\\\n        with self.conn:\\\\r\\\\n            self.conn.execute(\\\\\\\"DELETE FROM materials WHERE id=?\\\\\\\", (material_id,))\\\\r\\\\n            self._audit(actor, \\\\\\\"material.delete\\\\\\\", material_id, item[\\\\\\\"slug\\\\\\\"])\\\\r\\\\n\\\\r\\\\n    def bulk(self, ids, operation, actor):\\\\r\\\\n        if operation not in {\\\\\\\"delete\\\\\\\", \\\\\\\"review\\\\\\\", \\\\\\\"published\\\\\\\", \\\\\\\"archived\\\\\\\", \\\\\\\"draft\\\\\\\"}:\\\\r\\\\n            raise ValueError(\\\\\\\"Неизвестная пакетная операция\\\\\\\")\\\\r\\\\n        if not ids or len(ids) > 100 or len(set(ids)) != len(ids):\\\\r\\\\n            raise ValueError(\\\\\\\"Пакет должен содержать от 1 до 100 различных материалов\\\\\\\")\\\\r\\\\n        # Preflight every row before mutations; outer savepoint protects the complete batch.\\\\r\\\\n        for material_id in ids:\\\\r\\\\n            item = self._existing(material_id)\\\\r\\\\n            permission = \\\\\\\"delete\\\\\\\" if operation == \\\\\\\"delete\\\\\\\" else {\\\\\\\"review\\\\\\\": \\\\\\\"review\\\\\\\", \\\\\\\"published\\\\\\\": \\\\\\\"publish\\\\\\\", \\\\\\\"archived\\\\\\\": \\\\\\\"archive\\\\\\\", \\\\\\\"draft\\\\\\\": \\\\\\\"draft\\\\\\\"}[operation]\\\\r\\\\n            self._require(actor, permission, item)\\\\r\\\\n            if operation != \\\\\\\"delete\\\\\\\" and operation not in self.TRANSITIONS[item[\\\\\\\"status\\\\\\\"]]:\\\\r\\\\n                raise ValueError(\\\\\\\"Пакет содержит недопустимый переход\\\\\\\")\\\\r\\\\n        self.conn.execute(\\\\\\\"SAVEPOINT batch\\\\\\\")\\\\r\\\\n        try:\\\\r\\\\n            for material_id in ids:\\\\r\\\\n                item = self._existing(material_id)\\\\r\\\\n                if operation == \\\\\\\"delete\\\\\\\":\\\\r\\\\n                    self.conn.execute(\\\\\\\"DELETE FROM materials WHERE id=?\\\\\\\", (material_id,))\\\\r\\\\n                    self._audit(actor, \\\\\\\"material.delete\\\\\\\", material_id, \\\\\\\"bulk\\\\\\\")\\\\r\\\\n                else:\\\\r\\\\n                    published_at = now() if operation == \\\\\\\"published\\\\\\\" and not item[\\\\\\\"published_at\\\\\\\"] else item[\\\\\\\"published_at\\\\\\\"]\\\\r\\\\n                    self.conn.execute(\\\\\\\"UPDATE materials SET status=?,published_at=?,revision=revision+1,updated_at=? WHERE id=?\\\\\\\",\\\\r\\\\n                                      (operation, published_at, now(), material_id))\\\\r\\\\n                    self._revision(material_id, actor)\\\\r\\\\n                    self._audit(actor, \\\\\\\"material.transition\\\\\\\", material_id, \\\\\\\"bulk:\\\\\\\" + operation)\\\\r\\\\n            self.conn.execute(\\\\\\\"RELEASE batch\\\\\\\")\\\\r\\\\n            self.conn.commit()\\\\r\\\\n        except Exception:\\\\r\\\\n            self.conn.execute(\\\\\\\"ROLLBACK TO batch\\\\\\\")\\\\r\\\\n            self.conn.execute(\\\\\\\"RELEASE batch\\\\\\\")\\\\r\\\\n            raise\\\\r\\\\n        return len(ids)\\\\r\\\\n\\\\r\\\\n    def save_media(self, filename, content, actor):\\\\r\\\\n        self._require(actor, \\\\\\\"media\\\\\\\")\\\\r\\\\n        if not isinstance(content, bytes) or not content or len(content) > 5 * 1024 * 1024:\\\\r\\\\n            raise ValueError(\\\\\\\"Изображение должно быть размером до 5 МБ\\\\\\\")\\\\r\\\\n        from PIL import Image, ImageOps, UnidentifiedImageError\\\\r\\\\n        try:\\\\r\\\\n            with Image.open(BytesIO(content)) as source:\\\\r\\\\n                if source.format not in {\\\\\\\"PNG\\\\\\\", \\\\\\\"JPEG\\\\\\\", \\\\\\\"WEBP\\\\\\\"}:\\\\r\\\\n                    raise ValueError(\\\\\\\"Допустимы PNG, JPEG и WebP\\\\\\\")\\\\r\\\\n                if source.width * source.height > 20000000:\\\\r\\\\n                    raise ValueError(\\\\\\\"Изображение слишком большое\\\\\\\")\\\\r\\\\n                source.load()\\\\r\\\\n                image = ImageOps.exif_transpose(source).convert(\\\\\\\"RGB\\\\\\\")\\\\r\\\\n        except (UnidentifiedImageError, OSError, Image.DecompressionBombError) as exc:\\\\r\\\\n            raise ValueError(\\\\\\\"Файл не является поддерживаемым изображением\\\\\\\") from exc\\\\r\\\\n        media_dir = self.root / \\\\\\\"data\\\\\\\" / \\\\\\\"media\\\\\\\"\\\\r\\\\n        media_dir.mkdir(parents=True, exist_ok=True)\\\\r\\\\n        name = secrets.token_hex(16)\\\\r\\\\n        names = {\\\\\\\"filename\\\\\\\": name + \\\\\\\".jpg\\\\\\\", \\\\\\\"thumb\\\\\\\": name + \\\\\\\"-thumb.jpg\\\\\\\", \\\\\\\"preview\\\\\\\": name + \\\\\\\"-preview.jpg\\\\\\\"}\\\\r\\\\n        written = []\\\\r\\\\n        try:\\\\r\\\\n            for key, size in [(\\\\\\\"filename\\\\\\\", None), (\\\\\\\"thumb\\\\\\\", (320, 320)), (\\\\\\\"preview\\\\\\\", (960, 960))]:\\\\r\\\\n                derivative = image.copy()\\\\r\\\\n                if size:\\\\r\\\\n                    derivative.thumbnail(size)\\\\r\\\\n                path = media_dir / names[key]\\\\r\\\\n                derivative.save(path, \\\\\\\"JPEG\\\\\\\", quality=88)\\\\r\\\\n                written.append(path)\\\\r\\\\n            with self.conn:\\\\r\\\\n                cursor = self.conn.execute(\\\\r\\\\n                    \\\\\\\"INSERT INTO media(filename,original_name,mime,size,width,height,thumb,preview,uploader_id,created_at) \\\\\\\"\\\\r\\\\n                    \\\\\\\"VALUES(?,?,?,?,?,?,?,?,?,?)\\\\\\\",\\\\r\\\\n                    (names[\\\\\\\"filename\\\\\\\"], Path(filename).name[:200], \\\\\\\"image/jpeg\\\\\\\", written[0].stat().st_size,\\\\r\\\\n                     image.width, image.height, names[\\\\\\\"thumb\\\\\\\"], names[\\\\\\\"preview\\\\\\\"], actor[\\\\\\\"id\\\\\\\"], now()),\\\\r\\\\n                )\\\\r\\\\n                self._audit(actor, \\\\\\\"media.upload\\\\\\\", None, names[\\\\\\\"filename\\\\\\\"])\\\\r\\\\n        except Exception:\\\\r\\\\n            for path in written:\\\\r\\\\n                path.unlink(missing_ok=True)\\\\r\\\\n            raise\\\\r\\\\n        return dict(self.conn.execute(\\\\\\\"SELECT * FROM media WHERE id=?\\\\\\\", (cursor.lastrowid,)).fetchone())\\\\r\\\\n\\\\r\\\\n    def list_media(self, actor):\\\\r\\\\n        self._require(actor, \\\\\\\"media\\\\\\\")\\\\r\\\\n        return [dict(r) for r in self.conn.execute(\\\\\\\"SELECT * FROM media ORDER BY id DESC\\\\\\\")]\\\\r\\\\n\\\\r\\\\n    def record_view(self, material_id):\\\\r\\\\n        item = self._existing(material_id)\\\\r\\\\n        if item[\\\\\\\"status\\\\\\\"] != \\\\\\\"published\\\\\\\":\\\\r\\\\n            raise ValueError(\\\\\\\"Просмотр доступен только опубликованному материалу\\\\\\\")\\\\r\\\\n        with self.conn:\\\\r\\\\n            self.conn.execute(\\\\\\\"INSERT INTO views(material_id,viewed_at) VALUES(?,?)\\\\\\\", (material_id, now()))\\\\r\\\\n\\\\r\\\\n    def stats(self, actor):\\\\r\\\\n        self._require(actor, \\\\\\\"stats\\\\\\\")\\\\r\\\\n        return {\\\\r\\\\n            \\\\\\\"total_views\\\\\\\": self.conn.execute(\\\\\\\"SELECT count(*) FROM views\\\\\\\").fetchone()[0],\\\\r\\\\n            \\\\\\\"views\\\\\\\": [dict(r) for r in self.conn.execute(\\\\\\\"SELECT m.id,m.title,count(v.id) AS count FROM materials m LEFT JOIN views v ON v.material_id=m.id GROUP BY m.id ORDER BY count DESC\\\\\\\")],\\\\r\\\\n            \\\\\\\"publications\\\\\\\": [dict(r) for r in self.conn.execute(\\\\\\\"SELECT substr(published_at,1,10) AS day,count(*) AS count FROM materials WHERE published_at IS NOT NULL GROUP BY day ORDER BY day\\\\\\\")],\\\\r\\\\n            \\\\\\\"authors\\\\\\\": [dict(r) for r in self.conn.execute(\\\\\\\"SELECT u.username,count(DISTINCT m.id) AS materials,count(DISTINCT a.id) AS actions FROM users u LEFT JOIN materials m ON m.author_id=u.id LEFT JOIN audit a ON a.actor_id=u.id GROUP BY u.id ORDER BY materials DESC\\\\\\\")],\\\\r\\\\n        }\\\\r\\\\n\\\\r\\\\n    def audit(self, actor):\\\\r\\\\n        self._require(actor, \\\\\\\"audit\\\\\\\")\\\\r\\\\n        return [dict(r) for r in self.conn.execute(\\\\\\\"SELECT a.*,u.username FROM audit a LEFT JOIN users u ON u.id=a.actor_id ORDER BY a.id DESC LIMIT 200\\\\\\\")]\\\\r\\\\n\\\\r\\\\n    def seed(self, password):\\\\r\\\\n        \\\\\\\"\\\\\\\"\\\\\\\"Initialize a demonstrator. Password is supplied by setup, never hard coded.\\\\\\\"\\\\\\\"\\\\\\\"\\\\r\\\\n        if self.conn.execute(\\\\\\\"SELECT 1 FROM users LIMIT 1\\\\\\\").fetchone():\\\\r\\\\n            return False\\\\r\\\\n        admin = self.create_user(\\\\\\\"admin\\\\\\\", password, \\\\\\\"admin\\\\\\\")\\\\r\\\\n        self.create_user(\\\\\\\"editor\\\\\\\", password, \\\\\\\"editor\\\\\\\", admin)\\\\r\\\\n        author = self.create_user(\\\\\\\"author\\\\\\\", password, \\\\\\\"author\\\\\\\", admin)\\\\r\\\\n        examples = [\\\\r\\\\n            (\\\\\\\"news\\\\\\\", \\\\\\\"Открыта мастерская интернет приложений\\\\\\\", \\\\\\\"internet-workshop\\\\\\\", \\\\\\\"Практикум объединяет проектирование, разработку и проверку учебных веб-систем.\\\\\\\", {\\\\\\\"lead\\\\\\\": \\\\\\\"От идеи до работающего приложения\\\\\\\"}, \\\\\\\"Новости кафедры\\\\\\\", [\\\\\\\"разработка\\\\\\\", \\\\\\\"практика\\\\\\\"]),\\\\r\\\\n            (\\\\\\\"news\\\\\\\", \\\\\\\"Неделя открытых проектов\\\\\\\", \\\\\\\"open-projects\\\\\\\", \\\\\\\"Студенты представят прототипы и обсудят результаты независимой проверки.\\\\\\\", {\\\\\\\"lead\\\\\\\": \\\\\\\"Приглашаем на демонстрации\\\\\\\"}, \\\\\\\"Новости кафедры\\\\\\\", [\\\\\\\"проекты\\\\\\\"]),\\\\r\\\\n            (\\\\\\\"course\\\\\\\", \\\\\\\"Проектирование интернет приложений\\\\\\\", \\\\\\\"web-design\\\\\\\", \\\\\\\"Контентные модели, архитектура, интерфейсы и проверка качества.\\\\\\\", {\\\\\\\"teacher\\\\\\\": \\\\\\\"Кафедра информационных систем\\\\\\\", \\\\\\\"hours\\\\\\\": 72}, \\\\\\\"Обучение\\\\\\\", [\\\\\\\"веб\\\\\\\", \\\\\\\"архитектура\\\\\\\"]),\\\\r\\\\n            (\\\\\\\"course\\\\\\\", \\\\\\\"Практикум по Python\\\\\\\", \\\\\\\"python-course\\\\\\\", \\\\\\\"Разработка прикладных сервисов и автоматизированных проверок.\\\\\\\", {\\\\\\\"teacher\\\\\\\": \\\\\\\"Учебная лаборатория\\\\\\\", \\\\\\\"hours\\\\\\\": 36}, \\\\\\\"Обучение\\\\\\\", [\\\\\\\"python\\\\\\\"]),\\\\r\\\\n            (\\\\\\\"event\\\\\\\", \\\\\\\"Демонстрация учебных CMS\\\\\\\", \\\\\\\"cms-demo\\\\\\\", \\\\\\\"Каждая команда покажет публикацию материала и изменение контентной схемы.\\\\\\\", {\\\\\\\"date\\\\\\\": \\\\\\\"2026-12-10\\\\\\\", \\\\\\\"location\\\\\\\": \\\\\\\"Учебная лаборатория\\\\\\\"}, \\\\\\\"События\\\\\\\", [\\\\\\\"cms\\\\\\\", \\\\\\\"проекты\\\\\\\"]),\\\\r\\\\n            (\\\\\\\"event\\\\\\\", \\\\\\\"Семинар по тестированию\\\\\\\", \\\\\\\"testing-seminar\\\\\\\", \\\\\\\"Разберём сценарии проверки прав доступа, публикации и восстановления ревизий.\\\\\\\", {\\\\\\\"date\\\\\\\": \\\\\\\"2026-12-03\\\\\\\", \\\\\\\"location\\\\\\\": \\\\\\\"Аудитория 41\\\\\\\"}, \\\\\\\"События\\\\\\\", [\\\\\\\"тестирование\\\\\\\"]),\\\\r\\\\n            (\\\\\\\"resource\\\\\\\", \\\\\\\"Документация Python\\\\\\\", \\\\\\\"python-docs\\\\\\\", \\\\\\\"Официальный справочник стандартной библиотеки.\\\\\\\", {\\\\\\\"url\\\\\\\": \\\\\\\"https://docs.python.org/3/\\\\\\\", \\\\\\\"format\\\\\\\": \\\\\\\"Справочник\\\\\\\"}, \\\\\\\"Материалы\\\\\\\", [\\\\\\\"python\\\\\\\", \\\\\\\"документация\\\\\\\"]),\\\\r\\\\n            (\\\\\\\"resource\\\\\\\", \\\\\\\"Руководство SQLite\\\\\\\", \\\\\\\"sqlite-docs\\\\\\\", \\\\\\\"Документация по запросам, транзакциям и ограничениям SQLite.\\\\\\\", {\\\\\\\"url\\\\\\\": \\\\\\\"https://www.sqlite.org/docs.html\\\\\\\", \\\\\\\"format\\\\\\\": \\\\\\\"Документация\\\\\\\"}, \\\\\\\"Материалы\\\\\\\", [\\\\\\\"базы данных\\\\\\\"]),\\\\r\\\\n        ]\\\\r\\\\n        for type_name, title, slug, body, fields, category, tags in examples:\\\\r\\\\n            item = self.create({\\\\\\\"type\\\\\\\": type_name, \\\\\\\"title\\\\\\\": title, \\\\\\\"slug\\\\\\\": slug, \\\\\\\"body\\\\\\\": body,\\\\r\\\\n                                \\\\\\\"description\\\\\\\": body[:160], \\\\\\\"fields\\\\\\\": fields, \\\\\\\"category\\\\\\\": category, \\\\\\\"tags\\\\\\\": tags}, author)\\\\r\\\\n            self.transition(item[\\\\\\\"id\\\\\\\"], \\\\\\\"review\\\\\\\", author)\\\\r\\\\n            self.transition(item[\\\\\\\"id\\\\\\\"], \\\\\\\"published\\\\\\\", admin)\\\\r\\\\n        return True\\\\r\\\\n\\\"}}\"}, {\"type\": \"input_text\", \"text\": \"{\\\"i\\\":1,\\\"status\\\":\\\"fulfilled\\\",\\\"value\\\":{\\\"chunk_id\\\":\\\"cdcd2d\\\",\\\"wall_time_seconds\\\":0.4399151,\\\"exit_code\\\":0,\\\"original_token_count\\\":3724,\\\"output\\\":\\\"\\\\\\\"\\\\\\\"\\\\\\\"Small WSGI presentation layer and an escaping template renderer.\\\\\\\"\\\\\\\"\\\\\\\"\\\\r\\\\nfrom __future__ import annotations\\\\r\\\\n\\\\r\\\\nimport html\\\\r\\\\nimport io\\\\r\\\\nimport json\\\\r\\\\nimport mimetypes\\\\r\\\\nimport re\\\\r\\\\nimport secrets\\\\r\\\\nimport time\\\\r\\\\nfrom email import policy\\\\r\\\\nfrom email.parser import BytesParser\\\\r\\\\nfrom http.cookies import SimpleCookie\\\\r\\\\nfrom pathlib import Path\\\\r\\\\nfrom urllib.parse import parse_qs, quote, urlencode\\\\r\\\\n\\\\r\\\\n\\\\r\\\\nclass SafeHTML(str):\\\\r\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"HTML produced by the renderer, never by a content field.\\\\\\\"\\\\\\\"\\\\\\\"\\\\r\\\\n\\\\r\\\\n\\\\r\\\\nclass Templates:\\\\r\\\\n    def __init__(self, root):\\\\r\\\\n        self.root = Path(root)\\\\r\\\\n\\\\r\\\\n    def render(self, name, values=None):\\\\r\\\\n        values = values or {}\\\\r\\\\n        if not re.fullmatch(r\\\\\\\"[a-z_]+\\\\\\\\.html\\\\\\\", name):\\\\r\\\\n            raise ValueError(\\\\\\\"Недопустимое имя шаблона\\\\\\\")\\\\r\\\\n        source = (self.root / name).read_text(encoding=\\\\\\\"utf-8\\\\\\\")\\\\r\\\\n        parent = re.search(r'{% extends \\\\\\\"([a-z_]+\\\\\\\\.html)\\\\\\\" %}', source)\\\\r\\\\n        if parent:\\\\r\\\\n            blocks = dict(re.findall(r\\\\\\\"{% block (\\\\\\\\w+) %}(.*?){% endblock %}\\\\\\\", source, re.S))\\\\r\\\\n            source = (self.root / parent.group(1)).read_text(encoding=\\\\\\\"utf-8\\\\\\\")\\\\r\\\\n            source = re.sub(r\\\\\\\"{% block (\\\\\\\\w+) %}(.*?){% endblock %}\\\\\\\", lambda m: blocks.get(m[1], m[2]), source, flags=re.S)\\\\r\\\\n        source = re.sub(r'{% include \\\\\\\"([a-z_]+\\\\\\\\.html)\\\\\\\" %}', lambda m: str(self.render(m[1], values)), source)\\\\r\\\\n        def replace(match):\\\\r\\\\n            value = values.get(match[1], \\\\\\\"\\\\\\\")\\\\r\\\\n            return str(value) if isinstance(value, SafeHTML) else html.escape(str(value), quote=True)\\\\r\\\\n        return SafeHTML(re.sub(r\\\\\\\"{{\\\\\\\\s*(\\\\\\\\w+)\\\\\\\\s*}}\\\\\\\", replace, source))\\\\r\\\\n\\\\r\\\\n\\\\r\\\\nclass Request:\\\\r\\\\n    def __init__(self, environ):\\\\r\\\\n        self.method = environ.get(\\\\\\\"REQUEST_METHOD\\\\\\\", \\\\\\\"GET\\\\\\\")\\\\r\\\\n        self.path = environ.get(\\\\\\\"PATH_INFO\\\\\\\", \\\\\\\"/\\\\\\\")\\\\r\\\\n        self.query = parse_qs(environ.get(\\\\\\\"QUERY_STRING\\\\\\\", \\\\\\\"\\\\\\\"), keep_blank_values=True)\\\\r\\\\n        self.cookies = SimpleCookie()\\\\r\\\\n        try:\\\\r\\\\n            self.cookies.load(environ.get(\\\\\\\"HTTP_COOKIE\\\\\\\", \\\\\\\"\\\\\\\"))\\\\r\\\\n        except Exception:\\\\r\\\\n            self.cookies = SimpleCookie()\\\\r\\\\n        self.form = {}\\\\r\\\\n        self.files = {}\\\\r\\\\n        if self.method == \\\\\\\"POST\\\\\\\":\\\\r\\\\n            length = int(environ.get(\\\\\\\"CONTENT_LENGTH\\\\\\\") or 0)\\\\r\\\\n            if length < 0 or length > 10 * 1024 * 1024:\\\\r\\\\n                raise ValueError(\\\\\\\"Размер запроса превышает 10 МБ\\\\\\\")\\\\r\\\\n            body = environ.get(\\\\\\\"wsgi.input\\\\\\\", io.BytesIO()).read(length)\\\\r\\\\n            content_type = environ.get(\\\\\\\"CONTENT_TYPE\\\\\\\", \\\\\\\"\\\\\\\")\\\\r\\\\n            if content_type.startswith(\\\\\\\"multipart/form-data\\\\\\\"):\\\\r\\\\n                message = BytesParser(policy=policy.default).parsebytes(b\\\\\\\"Content-Type: \\\\\\\" + content_type.encode(\\\\\\\"ascii\\\\\\\") + b\\\\\\\"\\\\\\\\r\\\\\\\\nMIME-Version: 1.0\\\\\\\\r\\\\\\\\n\\\\\\\\r\\\\\\\\n\\\\\\\" + body)\\\\r\\\\n                if not message.is_multipart():\\\\r\\\\n                    raise ValueError(\\\\\\\"Некорректная форма загрузки\\\\\\\")\\\\r\\\\n                for part in message.iter_parts():\\\\r\\\\n                    name = part.get_param(\\\\\\\"name\\\\\\\", header=\\\\\\\"content-disposition\\\\\\\")\\\\r\\\\n                    filename = part.get_filename()\\\\r\\\\n                    if filename is not None:\\\\r\\\\n                        self.files[name] = (filename, part.get_payload(decode=True))\\\\r\\\\n                    elif name:\\\\r\\\\n                        self.form.setdefault(name, []).append(part.get_payload(decode=True).decode(\\\\\\\"utf-8\\\\\\\"))\\\\r\\\\n            else:\\\\r\\\\n                self.form = parse_qs(body.decode(\\\\\\\"utf-8\\\\\\\"), keep_blank_values=True)\\\\r\\\\n\\\\r\\\\n    def get(self, name, default=\\\\\\\"\\\\\\\"):\\\\r\\\\n        return self.query.get(name, [default])[0]\\\\r\\\\n\\\\r\\\\n    def post(self, name, default=\\\\\\\"\\\\\\\"):\\\\r\\\\n        return self.form.get(name, [default])[0]\\\\r\\\\n\\\\r\\\\n    def cookie(self, name):\\\\r\\\\n        value = self.cookies.get(name)\\\\r\\\\n        return value.value if value else \\\\\\\"\\\\\\\"\\\\r\\\\n\\\\r\\\\n\\\\r\\\\nclass WebApp:\\\\r\\\\n    def __init__(self, cms, root=None):\\\\r\\\\n        self.cms = cms\\\\r\\\\n        self.root = Path(root or Path(__file__).parent)\\\\r\\\\n        self.templates = Templates(self.root / \\\\\\\"templates\\\\\\\")\\\\r\\\\n        self.csrf_nonces = {}\\\\r\\\\n\\\\r\\\\n    def __call__(self, environ, start_response):\\\\r\\\\n        self_extra = []\\\\r\\\\n        try:\\\\r\\\\n            req = Request(environ)\\\\r\\\\n            req.session = req.cookie(\\\\\\\"cms_session\\\\\\\")\\\\r\\\\n            req.user = self.cms.session_user(req.session) if req.session else None\\\\r\\\\n            req.theme = req.get(\\\\\\\"theme\\\\\\\", req.cookie(\\\\\\\"cms_theme\\\\\\\") or \\\\\\\"light\\\\\\\")\\\\r\\\\n            if req.theme not in {\\\\\\\"light\\\\\\\", \\\\\\\"contrast\\\\\\\"}:\\\\r\\\\n                req.theme = \\\\\\\"light\\\\\\\"\\\\r\\\\n            req.csrf = req.cookie(\\\\\\\"cms_csrf\\\\\\\")\\\\r\\\\n            if req.csrf not in self.csrf_nonces or self.csrf_nonces.get(req.csrf, 0) < time.time():\\\\r\\\\n                req.csrf = secrets.token_urlsafe(32)\\\\r\\\\n                self.csrf_nonces[req.csrf] = time.time() + 7200\\\\r\\\\n                self_extra.append((\\\\\\\"Set-Cookie\\\\\\\", f\\\\\\\"cms_csrf={req.csrf}; Path=/; HttpOnly; SameSite=Strict\\\\\\\"))\\\\r\\\\n            if len(self.csrf_nonces) > 2000:\\\\r\\\\n                self.csrf_nonces = {key: expiry for key, expiry in self.csrf_nonces.items() if expiry > time.time()}\\\\r\\\\n            if req.get(\\\\\\\"theme\\\\\\\"):\\\\r\\\\n                self_extra.append((\\\\\\\"Set-Cookie\\\\\\\", f\\\\\\\"cms_theme={req.theme}; Path=/; SameSite=Lax\\\\\\\"))\\\\r\\\\n            if req.method not in {\\\\\\\"GET\\\\\\\", \\\\\\\"HEAD\\\\\\\", \\\\\\\"POST\\\\\\\"}:\\\\r\\\\n                result = self.error(req, 405, \\\\\\\"Метод не поддерживается\\\\\\\")\\\\r\\\\n            elif req.method == \\\\\\\"POST\\\\\\\" and not secrets.compare_digest(req.post(\\\\\\\"csrf\\\\\\\"), req.csrf):\\\\r\\\\n                result = self.error(req, 403, \\\\\\\"Не удалось проверить форму. Обновите страницу.\\\\\\\")\\\\r\\\\n            else:\\\\r\\\\n                result = self.route(req)\\\\r\\\\n        except PermissionError as exc:\\\\r\\\\n            result = self.error(locals().get(\\\\\\\"req\\\\\\\"), 403, str(exc) or \\\\\\\"Доступ запрещён\\\\\\\")\\\\r\\\\n        except LookupError as exc:\\\\r\\\\n            result = self.error(locals().get(\\\\\\\"req\\\\\\\"), 404, str(exc) or \\\\\\\"Страница не найдена\\\\\\\")\\\\r\\\\n        except (ValueError, UnicodeError) as exc:\\\\r\\\\n            result = self.error(locals().get(\\\\\\\"req\\\\\\\"), 400, str(exc))\\\\r\\\\n        except Exception:\\\\r\\\\n            import traceback\\\\r\\\\n            traceback.print_exc()\\\\r\\\\n            result = self.error(locals().get(\\\\\\\"req\\\\\\\"), 500, \\\\\\\"Внутренняя ошибка сервера\\\\\\\")\\\\r\\\\n        status, headers, body = result\\\\r\\\\n        if isinstance(body, str):\\\\r\\\\n            body = body.encode(\\\\\\\"utf-8\\\\\\\")\\\\r\\\\n        headers += self_extra + [(\\\\\\\"Content-Length\\\\\\\", str(len(body))), (\\\\\\\"X-Content-Type-Options\\\\\\\", \\\\\\\"nosniff\\\\\\\"), (\\\\\\\"X-Frame-Options\\\\\\\", \\\\\\\"DENY\\\\\\\"), (\\\\\\\"Referrer-Policy\\\\\\\", \\\\\\\"same-origin\\\\\\\"), (\\\\\\\"Content-Security-Policy\\\\\\\", \\\\\\\"default-src 'self'; style-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'\\\\\\\")]\\\\r\\\\n        start_response(f\\\\\\\"{status} { {200:'OK',302:'Found',400:'Bad Request',403:'Forbidden',404:'Not Found',405:'Method Not Allowed',500:'Internal Server Error'}.get(status,'OK')}\\\\\\\", headers)\\\\r\\\\n        return [b\\\\\\\"\\\\\\\" if environ.get(\\\\\\\"REQUEST_METHOD\\\\\\\") == \\\\\\\"HEAD\\\\\\\" else body]\\\\r\\\\n\\\\r\\\\n    def redirect(self, url, cookies=None):\\\\r\\\\n        return 302, [(\\\\\\\"Location\\\\\\\", url)] + (cookies or []), \\\\\\\"\\\\\\\"\\\\r\\\\n\\\\r\\\\n    def render(self, name, values=None):\\\\r\\\\n        return self.templates.render(name, values)\\\\r\\\\n\\\\r\\\\n    def page(self, req, title, content, description=\\\\\\\"Учебный портал кафедры — новости, курсы, события и материалы\\\\\\\"):\\\\r\\\\n        menu = SafeHTML(\\\\\\\"\\\\\\\".join(self.render(\\\\\\\"menu_item.html\\\\\\\", {\\\\\\\"url\\\\\\\": \\\\\\\"/?\\\\\\\" + urlencode({\\\\\\\"type\\\\\\\": key}), \\\\\\\"label\\\\\\\": schema.get(\\\\\\\"label\\\\\\\", key)}) for key, schema in self.cms.schemas.items()))\\\\r\\\\n        user = getattr(req, \\\\\\\"user\\\\\\\", None)\\\\r\\\\n        account = self.render(\\\\\\\"account.html\\\\\\\", {\\\\\\\"username\\\\\\\": user[\\\\\\\"username\\\\\\\"], \\\\\\\"csrf\\\\\\\": req.csrf}) if user else self.render(\\\\\\\"login_link.html\\\\\\\")\\\\r\\\\n        body = self.render(\\\\\\\"page.html\\\\\\\", {\\\\\\\"title\\\\\\\": title, \\\\\\\"description\\\\\\\": description, \\\\\\\"theme\\\\\\\": getattr(req,\\\\\\\"theme\\\\\\\",\\\\\\\"light\\\\\\\"), \\\\\\\"menu\\\\\\\": menu, \\\\\\\"account\\\\\\\": account, \\\\\\\"content\\\\\\\": content})\\\\r\\\\n        return 200, [(\\\\\\\"Content-Type\\\\\\\", \\\\\\\"text/html; charset=utf-8\\\\\\\"), (\\\\\\\"Cache-Control\\\\\\\", \\\\\\\"no-store\\\\\\\")], body\\\\r\\\\n\\\\r\\\\n    def error(self, req, status, text):\\\\r\\\\n        if req is None:\\\\r\\\\n            return status, [(\\\\\\\"Content-Type\\\\\\\", \\\\\\\"text/plain; charset=utf-8\\\\\\\")], text\\\\r\\\\n        content = self.render(\\\\\\\"error.html\\\\\\\", {\\\\\\\"code\\\\\\\": status, \\\\\\\"message\\\\\\\": text})\\\\r\\\\n        _, headers, body = self.page(req, \\\\\\\"Ошибка\\\\\\\", content)\\\\r\\\\n        return status, headers, body\\\\r\\\\n\\\\r\\\\n    def require_user(self, req):\\\\r\\\\n        if not req.user:\\\\r\\\\n            raise PermissionError(\\\\\\\"Для этого действия необходимо войти\\\\\\\")\\\\r\\\\n\\\\r\\\\n    def card(self, item):\\\\r\\\\n        return self.render(\\\\\\\"card.html\\\\\\\", {\\\\\\\"title\\\\\\\": item[\\\\\\\"title\\\\\\\"], \\\\\\\"url\\\\\\\": \\\\\\\"/material/\\\\\\\" + quote(item[\\\\\\\"slug\\\\\\\"]), \\\\\\\"type\\\\\\\": self.cms.schemas[item[\\\\\\\"type\\\\\\\"]].get(\\\\\\\"label\\\\\\\", item[\\\\\\\"type\\\\\\\"]), \\\\\\\"description\\\\\\\": item.get(\\\\\\\"description\\\\\\\") or item.get(\\\\\\\"body\\\\\\\", \\\\\\\"\\\\\\\")[:180], \\\\\\\"category\\\\\\\": item.get(\\\\\\\"category\\\\\\\", \\\\\\\"\\\\\\\"), \\\\\\\"date\\\\\\\": (item.get(\\\\\\\"published_at\\\\\\\") or item.get(\\\\\\\"created_at\\\\\\\", \\\\\\\"\\\\\\\"))[:10]})\\\\r\\\\n\\\\r\\\\n    def route(self, req):\\\\r\\\\n        if req.path.startswith(\\\\\\\"/static/\\\\\\\"):\\\\r\\\\n            name = req.path.removeprefix(\\\\\\\"/static/\\\\\\\")\\\\r\\\\n            if name != \\\\\\\"style.css\\\\\\\":\\\\r\\\\n                raise LookupError(\\\\\\\"Файл не найден\\\\\\\")\\\\r\\\\n            return 200, [(\\\\\\\"Content-Type\\\\\\\", \\\\\\\"text/css; charset=utf-8\\\\\\\")], (self.root / \\\\\\\"static\\\\\\\" / name).read_bytes()\\\\r\\\\n        if req.path.startswith(\\\\\\\"/media/\\\\\\\"):\\\\r\\\\n            relative = req.path.removeprefix(\\\\\\\"/media/\\\\\\\")\\\\r\\\\n            path = (self.root / \\\\\\\"data\\\\\\\" / \\\\\\\"media\\\\\\\" / relative).resolve()\\\\r\\\\n            base = (self.root / \\\\\\\"data\\\\\\\" / \\\\\\\"media\\\\\\\").resolve()\\\\r\\\\n            if not path.is_relative_to(base) or not path.is_file() or path.suffix.lower() not in {\\\\\\\".jpg\\\\\\\", \\\\\\\".jpeg\\\\\\\", \\\\\\\".png\\\\\\\", \\\\\\\".webp\\\\\\\"}:\\\\r\\\\n                raise LookupError(\\\\\\\"Изображение не найдено\\\\\\\")\\\\r\\\\n            return 200, [(\\\\\\\"Content-Type\\\\\\\", mimetypes.guess_type(path.name)[0] or \\\\\\\"application/octet-stream\\\\\\\")], path.read_bytes()\\\\r\\\\n        if req.path == \\\\\\\"/login\\\\\\\":\\\\r\\\\n            if req.method == \\\\\\\"POST\\\\\\\":\\\\r\\\\n                user = self.cms.authenticate(req.post(\\\\\\\"username\\\\\\\"), req.post(\\\\\\\"password\\\\\\\"))\\\\r\\\\n                if not user:\\\\r\\\\n                    return self.page(req, \\\\\\\"Вход\\\\\\\", self.render(\\\\\\\"login.html\\\\\\\", {\\\\\\\"csrf\\\\\\\": req.csrf, \\\\\\\"error\\\\\\\": \\\\\\\"Неверное имя пользователя или пароль\\\\\\\"}))\\\\r\\\\n                token = self.cms.start_session(user)\\\\r\\\\n                return self.redirect(\\\\\\\"/admin\\\\\\\", [(\\\\\\\"Set-Cookie\\\\\\\", f\\\\\\\"cms_session={token}; Path=/; HttpOnly; SameSite=Strict\\\\\\\")])\\\\r\\\\n            return self.page(req, \\\\\\\"Вход\\\\\\\", self.render(\\\\\\\"login.html\\\\\\\", {\\\\\\\"csrf\\\\\\\": req.csrf}))\\\\r\\\\n        if req.path == \\\\\\\"/logout\\\\\\\":\\\\r\\\\n            if req.method != \\\\\\\"POST\\\\\\\":\\\\r\\\\n                return self.error(req, 405, \\\\\\\"Выход выполняется через форму\\\\\\\")\\\\r\\\\n            self.cms.end_session(req.session)\\\\r\\\\n            return self.redirect(\\\\\\\"/\\\\\\\", [(\\\\\\\"Set-Cookie\\\\\\\", \\\\\\\"cms_session=; Path=/; Max-Age=0; HttpOnly; SameSite=Strict\\\\\\\")])\\\\r\\\\n        if req.path == \\\\\\\"/api/materials\\\\\\\":\\\\r\\\\n            page = int(req.get(\\\\\\\"page\\\\\\\", \\\\\\\"1\\\\\\\"))\\\\r\\\\n            page_size = int(req.get(\\\\\\\"page_size\\\\\\\", \\\\\\\"10\\\\\\\"))\\\\r\\\\n            if page < 1 or not 1 <= page_size <= 100:\\\\r\\\\n                raise ValueError(\\\\\\\"page >= 1, page_size от 1 до 100\\\\\\\")\\\\r\\\\n            result = self.cms.list(public=True, type_name=req.get(\\\\\\\"type\\\\\\\") or None, category=req.get(\\\\\\\"category\\\\\\\") or None, tag=req.get(\\\\\\\"tag\\\\\\\") or None, q=req.get(\\\\\\\"q\\\\\\\") or None, page=page, page_size=page_size)\\\\r\\\\n            return 200, [(\\\\\\\"Content-Type\\\\\\\", \\\\\\\"application/json; charset=utf-8\\\\\\\")], json.dumps(result, ensure_ascii=False)\\\\r\\\\n        if req.path == \\\\\\\"/robots.txt\\\\\\\":\\\\r\\\\n            return 200, [(\\\\\\\"Content-Type\\\\\\\", \\\\\\\"text/plain; charset=utf-8\\\\\\\")], \\\\\\\"User-agent: *\\\\\\\\nAllow: /\\\\\\\\nDisallow: /admin\\\\\\\\nDisallow: /login\\\\\\\\nSitemap: /sitemap.xml\\\\\\\\n\\\\\\\"\\\\r\\\\n        if req.path == \\\\\\\"/sitemap.xml\\\\\\\":\\\\r\\\\n            items = self.cms.list(public=True, page_size=100)[\\\\\\\"items\\\\\\\"]\\\\r\\\\n            links = [\\\\\\\"/\\\\\\\"] + [\\\\\\\"/material/\\\\\\\" + quote(x[\\\\\\\"slug\\\\\\\"]) for x in items]\\\\r\\\\n            return 200, [(\\\\\\\"Content-Type\\\\\\\", \\\\\\\"application/xml; charset=utf-8\\\\\\\")], '<?xml version=\\\\\\\"1.0\\\\\\\" encoding=\\\\\\\"UTF-8\\\\\\\"?><urlset xmlns=\\\\\\\"http://www.sitemaps.org/schemas/sitemap/0.9\\\\\\\">' + \\\\\\\"\\\\\\\".join(\\\\\\\"<url><loc>http://localhost:8080\\\\\\\" + html.escape(link) + \\\\\\\"</loc></url>\\\\\\\" for link in links) + \\\\\\\"</urlset>\\\\\\\"\\\\r\\\\n        if req.path == \\\\\\\"/\\\\\\\":\\\\r\\\\n            result = self.cms.list(public=True, type_name=req.get(\\\\\\\"type\\\\\\\") or None, category=req.get(\\\\\\\"category\\\\\\\") or None, tag=req.get(\\\\\\\"tag\\\\\\\") or None, q=req.get(\\\\\\\"q\\\\\\\") or None, page=max(1,int(req.get(\\\\\\\"page\\\\\\\", \\\\\\\"1\\\\\\\"))), page_size=6)\\\\r\\\\nCREATE TABLE users (\\\\r\\\\n id INTEGER PRIMARY KEY, username TEXT NOT NULL UNIQUE, password_hash TEXT NOT NULL,\\\\r\\\\n role TEXT NOT NULL CHECK(role IN ('admin','editor','author'))\\\\r\\\\n);\\\\r\\\\nCREATE TABLE sessions (\\\\r\\\\n token_hash TEXT PRIMARY KEY, user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\\\\r\\\\n csrf TEXT NOT NULL, expires_at TEXT NOT NULL\\\\r\\\\n);\\\\r\\\\nCREATE TABLE content_types (name TEXT PRIMARY KEY, schema_json TEXT NOT NULL, version INTEGER NOT NULL);\\\\r\\\\nCREATE TABLE schema_history (\\\\r\\\\n id INTEGER PRIMARY KEY, type_name TEXT NOT NULL REFERENCES content_types(name),\\\\r\\\\n version INTEGER NOT NULL, digest TEXT NOT NULL, applied_at TEXT NOT NULL,\\\\r\\\\n UNIQUE(type_name,version)\\\\r\\\\n);\\\\r\\\\nCREATE TABLE materials (\\\\r\\\\n id INTEGER PRIMARY KEY, type TEXT NOT NULL REFERENCES content_types(name),\\\\r\\\\n title TEXT NOT NULL, slug TEXT NOT NULL UNIQUE, body TEXT NOT NULL DEFAULT '',\\\\r\\\\n description TEXT NOT NULL DEFAULT '', fields_json TEXT NOT NULL,\\\\r\\\\n status TEXT NOT NULL CHECK(status IN ('draft','review','published','archived')),\\\\r\\\\n author_id INTEGER NOT NULL REFERENCES users(id), revision INTEGER NOT NULL DEFAULT 1,\\\\r\\\\n created_at TEXT NOT NULL, updated_at TEXT NOT NULL, published_at TEXT\\\\r\\\\n);\\\\r\\\\nCREATE TABLE terms (\\\\r\\\\n id INTEGER PRIMARY KEY, kind TEXT NOT NULL CHECK(kind IN ('category','tag')),\\\\r\\\\n name TEXT NOT NULL, UNIQUE(kind,name)\\\\r\\\\n);\\\\r\\\\nCREATE TABLE material_terms (\\\\r\\\\n material_id INTEGER NOT NULL REFERENCES materials(id) ON DELETE CASCADE,\\\\r\\\\n term_id INTEGER NOT NULL REFERENCES terms(id) ON DELETE CASCADE,\\\\r\\\\n PRIMARY KEY(material_id,term_id)\\\\r\\\\n);\\\\r\\\\nCREATE TABLE revisions (\\\\r\\\\n id INTEGER PRIMARY KEY, material_id INTEGER NOT NULL REFERENCES materials(id) ON DELETE CASCADE,\\\\r\\\\n number INTEGER NOT NULL, snapshot TEXT NOT NULL, actor_id INTEGER NOT NULL REFERENCES users(id),\\\\r\\\\n created_at TEXT NOT NULL, UNIQUE(material_id,number)\\\\r\\\\n);\\\\r\\\\nCREATE TABLE audit (\\\\r\\\\n id INTEGER PRIMARY KEY, actor_id INTEGER REFERENCES users(id), operation TEXT NOT NULL,\\\\r\\\\n material_id INTEGER, detail TEXT NOT NULL, created_at TEXT NOT NULL\\\\r\\\\n);\\\\r\\\\nCREATE TABLE media (\\\\r\\\\n id INTEGER PRIMARY KEY, filename TEXT NOT NULL, original_name TEXT NOT NULL,\\\\r\\\\n mime TEXT NOT NULL, size INTEGER NOT NULL, width INTEGER NOT NULL, height INTEGER NOT NULL,\\\\r\\\\n thumb TEXT NOT NULL, preview TEXT NOT NULL, uploader_id INTEGER NOT NULL REFERENCES users(id),\\\\r\\\\n created_at TEXT NOT NULL\\\\r\\\\n);\\\\r\\\\nCREATE TABLE views (\\\\r\\\\n id INTEGER PRIMARY KEY, material_id INTEGER NOT NULL REFERENCES materials(id) ON DELETE CASCADE,\\\\r\\\\n viewed_at TEXT NOT NULL\\\\r\\\\n);\\\\r\\\\nCREATE INDEX idx_materials_public ON materials(status,published_at DESC);\\\\r\\\\nCREATE INDEX idx_materials_author ON materials(author_id);\\\\r\\\\nCREATE INDEX idx_views_period ON views(viewed_at,material_id);\\\\r\\\\nCREATE INDEX idx_terms_name ON terms(kind,name);\\\\r\\\\n\\\"}}\"}, {\"type\": \"input_text\", \"text\": \"{\\\"i\\\":2,\\\"status\\\":\\\"fulfilled\\\",\\\"value\\\":{\\\"chunk_id\\\":\\\"160ed1\\\",\\\"wall_time_seconds\\\":0.4415771,\\\"exit_code\\\":0,\\\"original_token_count\\\":885,\\\"output\\\":\\\"..\\\\\\\\Автоматизация проектирования интернет-приложений\\\\\\\\cms\\\\\\\\tests\\\\\\\\__pycache__\\\\\\\\test_harness.cpython-312.pyc\\\\n..\\\\\\\\Автоматизация проектирования интернет-приложений\\\\\\\\cms\\\\\\\\tests\\\\\\\\test_harness.py\\\\n# SPEC 01 Ядро CMS\\\\r\\\\n\\\\r\\\\nКонтекст: SPEC 00. Порции: схемы и миграции; контент и таксономия; ревизии; медиа; роли и сессии. Одна порция решает один инвариант и должна помещаться в один просмотр diff.\\\\r\\\\n\\\\r\\\\nТребования: JSON-схемы полей читаются при старте; тип добавляется файлом без изменения кода. Хранилище sqlite3 с параметризованными запросами и транзакциями. Связи материала с категориями и тегами контролируются внешними ключами. Каждая правка и откат создают новую ревизию. Сохраняются авторство, дата публикации и журнал действий. Обязательные поля, типы, длины, slug и состояния валидируются. Восстановление ревизии сохраняет текущий контроль доступа.\\\\r\\\\n\\\\r\\\\nПриёмка: не менее 25 тестов, включая round-trip, неизвестные поля, уникальность slug, отказ недопустимого перехода, атомарность ошибок, связи таксономии, откат, неверный пароль, истечение сессии, безопасную загрузку и производные изображения. Ошибки ввода возвращаются пользователю без трассировки и SQL.\\\\r\\\\n# SPEC 02 Интерфейсы и шаблоны\\\\r\\\\n\\\\r\\\\nКонтекст: SPEC 00 и SPEC 01. Собственная WSGI-панель без автоадминки.\\\\r\\\\n\\\\r\\\\nТребования: /login, /logout, /admin, формы создания и редактирования каждого типа, модерация, откат ревизий, фильтры, поиск и пакетная операция. Автор видит и изменяет свои материалы; редактор и администратор модерируют. Администратору доступны статистика и журнал действий. Каждая POST-форма имеет CSRF-токен. Публичная часть выдаёт только published. API /api/materials имеет page и page_size с верхней границей, фильтры category/tag/type. Шаблонный слой изолирован, поддерживает две темы, наследование и partial, все пользовательские строки экранируются по умолчанию.\\\\r\\\\n\\\\r\\\\nПриёмка: 10 и более проверок роль/операция, минимум 3 HTTP-сценария, включая вход и CRUD, публикацию и API, XSS и запрет доступа. Проверяются sitemap и метатеги. Действия через браузер и скриншоты фиксируются только после запуска настоящего приложения.\\\\r\\\\n\\\"}}\"}]", "event_id": "audit-00036"}
