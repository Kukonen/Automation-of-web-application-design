{"timestamp": "2026-11-15T19:41:45.388Z", "kind": "custom_tool_call_output", "call_id": "C0007", "output": "[{\"type\": \"input_text\", \"text\": \"Script completed\\nWall time 1.1 seconds\\nOutput:\\n\"}, {\"type\": \"input_text\", \"text\": \"\\r\\nFILE <PROFILE>\\\\Desktop\\\\магистратура\\\\пасм\\\\7\\\\Отчёт_ЛР7.docx\\r\\nTABLE 0 [['доцент, канд. техн. наук, доцент', '', '', '', 'О.О. Жаринов'], ['должность, уч. степень, звание', '', 'подпись, дата', '', 'инициалы, фамилия']]\\r\\nTABLE 1 [['ОТЧЕТ О ЛАБОРАТОРНОЙ РАБОТЕ № 7'], ['РАСПОЗНАВАНИЕ ОБЪЕКТОВ В ИЗОБРАЖЕНИЯХ'], ['ПО КУРСУ:\\\\nПрограммно-аппаратные средства мультимедиа']]\\r\\nTABLE 2 [['СТУДЕНТ ГР. №', '4513МК', '', '', '', 'Е.И. <STUDENT>'], ['', '', '', 'подпись, дата', '', 'инициалы, фамилия']]\\r\\nHEADINGS [('Heading 2', 'Цель работы'), ('Heading 2', 'Задание на лабораторную работу'), ('Heading 2', 'Теоретические сведения'), ('Heading 2', 'Исходные данные и подготовка'), ('Heading 2', 'Программа'), ('Heading 2', 'Описание программы'), ('Heading 2', 'Результаты работы'), ('Heading 2', 'Вывод'), ('Heading 2', 'Список литературы')]\\r\\nBODY FORMATS [(('JUSTIFY (3)', 1.2505972222222221, 1.15, 0), 201), (('None', 1.2505972222222221, 1.15, 0), 13), (('CENTER (1)', None, 1.15, 0), 8), (('CENTER (1)', None, 1.15, 6.0), 8), (('CENTER (1)', None, None, 0), 1)]\\r\\nBODY SAMPLE Санкт-Петербург, 2026 г.\\r\\n\\r\\n\\r\\nЦель работы\\r\\nИзучить методику обработки изображений с целью обнаружения объектов, соответствующих заданному эталону.\\r\\nЗадание на лабораторную работу\\r\\nВыполнить три части задания. В первой части вырезать эталон из исходного изображения и найти его положение. Во второй части автоматически находить все объекты, соответствующие эталону, при их количестве от 0 до 10 и наличии посторонних объектов. Подобрать порог и показать несколько пар исходных изображений и карт сходства. В третьей части добавить гауссовский шум к сцене с несколькими объектами и при неизменном эталоне определить уровень, на котором появляются первые ошибки. Показать результаты до и после появления ошибок.\\r\\nТеоретические сведения\\r\\nCAPTION Рисунок 1 - Исходная фотография NASA и вырезанный из нее эталон align CENTER (1) indent None line 1.15 before 0 after 6.0\\r\\n\\r\\nFILE <PROFILE>\\\\Desktop\\\\магистратура\\\\Методология инновационной деятельности\\\\пр 1\\\\Отчёт_ПР1.docx\\r\\nTABLE 0 [['канд. техн. наук', '', '', '', 'К.Б. Гурнов'], ['должность, уч. степень, звание', '', 'подпись, дата', '', 'инициалы, фамилия']]\\r\\nTABLE 1 [['ОТЧЕТ О ПРАКТИЧЕСКОЙ РАБОТЕ № 1'], ['МОДЕЛИРОВАНИЕ СИСТЕМЫ МАССОВОГО ОБСЛУЖИВАНИЯ СЛУЖБЫ СКОРОЙ ПОМОЩИ'], ['ПО КУРСУ:\\\\nМоделирование систем с очередями']]\\r\\nTABLE 2 [['СТУДЕНТ ГР. №', '4513МК', '', '', '', 'Е.И. <STUDENT>'], ['', '', '', 'подпись, дата', '', 'инициалы, фамилия']]\\r\\nHEADINGS [('Heading 2', 'Цель работы'), ('Heading 2', 'Модель и порядок расчёта'), ('Heading 2', 'Листинг программы'), ('Heading 2', 'Результаты расчёта'), ('Heading 2', 'Ограничение на базовые станции\\\\t'), ('Heading 2', 'Листинг программы с тремя базовыми станциями'), ('Heading 2', 'Выводы')]\\r\\nBODY FORMATS [(('JUSTIFY (3)', 1.2505972222222221, 1.15, 0), 65), (('None', None, 1.0, 0), 56), (('None', 1.2505972222222221, 1.15, 0), 7), (('RIGHT (2)', None, 1.15, 5.0), 3), (('CENTER (1)', None, None, 0), 1)]\\r\\nBODY SAMPLE Санкт-Петербург, 2026 г.\\r\\n\\r\\n\\r\\nЦель работы\\r\\nОпределить основные показатели многоканальной системы массового обслуживания с отказами и найти минимальное число каналов, при котором обслуживается не менее 90% поступающих вызовов.\\r\\nМодель и порядок расчёта\\r\\nВариант 3: в службе скорой помощи работают три диспетчера с тремя телефонными аппаратами. Интенсивность поступления составляет 4 вызова в минуту, среднее время оформления вызова – 1,5 минуты. Если все диспетчеры заняты, новый вызов получает отказ. Очередь отсутствует. Один канал обслуживания – аппарат вместе с доступным диспетчером.\\r\\nИспользуется многоканальная СМО с отказами. Входной поток принимается пуассоновским, времена обслуживания – независимыми, одинаково распределёнными, со средним значением 1,5 минуты. Состояние k означает занятость k каналов, где k изменяется от 0 до n. Интенсивность обслуживания одного непрерывно занятого канала μ = 1 / 1,5 = 2/3 вызова в минуту. Предлагаемая нагрузка (интенсивность нагрузки канала) λ/μ = λt = 6.\\r\\nCAPTION Таблица 1 – Вероятности состояний при трёх каналах align RIGHT (2) indent None line 1.15 before 0 after 5.0\\r\\n\\r\\nFILE <PROFILE>\\\\Desktop\\\\магистратура\\\\Методология инновационной деятельности\\\\лаб 2\\\\Отчёт_ЛР2.docx\\r\\nTABLE 0 [['канд. техн. наук', '', '', '', 'К.Б. Гурнов'], ['должность, уч. степень, звание', '', 'подпись, дата', '', 'инициалы, фамилия']]\\r\\nTABLE 1 [['ОТЧЕТ О ЛАБОРАТОРНОЙ РАБОТЕ № 2'], ['АНАЛИЗ СИСТЕМЫ МНОЖЕСТВЕННОГО ДОСТУПА С ПЕРЕДАЧЕЙ ПО РАСПИСАНИЮ'], ['ПО КУРСУ:\\\\nМоделирование систем с очередями']]\\r\\nTABLE 2 [['СТУДЕНТ ГР. №', '4513МК', '', '', '', 'Е.И. <STUDENT>'], ['', '', '', 'подпись, дата', '', 'инициалы, фамилия']]\\r\\nHEADINGS [('Heading 2', 'Цель работы'), ('Heading 2', 'Модель и порядок расчёта'), ('Heading 2', 'Листинг программы'), ('Heading 2', 'Результаты моделирования'), ('Heading 2', 'Выводы')]\\r\\nBODY FORMATS [(('None', None, 1.0, 0), 92), (('JUSTIFY (3)', 1.2505972222222221, 1.15, 0), 22), (('None', 1.2505972222222221, 1.15, 0), 5), (('RIGHT (2)', None, 1.15, 5.0), 2), (('CENTER (1)', None, 1.15, 0), 2)]\\r\\nBODY SAMPLE Санкт-Петербург, 2026 г.\\r\\n\\r\\n\\r\\nЦель работы\\r\\nПолучение навыков моделирования системы множественного доступа для сети с топологией двоичного дерева с передачей сообщений по расписанию. Сравнение двух расписаний и случайного доступа по среднему числу сообщений в системе.\\r\\nМодель и порядок расчёта\\r\\nСеть состоит из четырёх абонентов АБ1–АБ4, двух ретрансляторов Р1 и Р2 и базовой станции БС. АБ1 и АБ2 передают сообщения Р1, АБ3 и АБ4 – Р2. Оба ретранслятора передают сообщения БС. Все шесть очередей неограниченные; в начале опыта они пусты.\\r\\nВремя разделено на слоты. Каждый абонент получает за слот случайное число сообщений по распределению Пуассона со средним λ/4. Параметр λ задаёт суммарную интенсивность поступления от четырёх абонентов. Разрешённый расписанием узел передаёт одно сообщение, если его очередь непуста. Вероятности передачи здесь не перебираются.\\r\\nCAPTION Таблица 1 – Узлы, которым разрешена передача align RIGHT (2) indent None line 1.15 before 0 after 5.0\\r\\n\"}]", "event_id": "audit-00018"}
