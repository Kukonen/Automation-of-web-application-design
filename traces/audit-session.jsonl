{"timestamp": "2026-11-15T19:49:01.175Z", "kind": "custom_tool_call_output", "call_id": "C0014", "output": "[{\"type\": \"input_text\", \"text\": \"Script completed\\nWall time 0.6 seconds\\nOutput:\\n\"}, {\"type\": \"input_text\", \"text\": \"            raise LookupError(\\\"Материал не найден\\\")\\r\\n        return item\\r\\n\\r\\n    def list(self, public=True, actor=None, type_name=None, category=None, tag=None, q=None, status=None, page=1, page_size=10):\\r\\n        if isinstance(page, bool) or isinstance(page_size, bool):\\r\\n            raise ValueError(\\\"Некорректная пагинация\\\")\\r\\n        try:\\r\\n            page, page_size = int(page), int(page_size)\\r\\n        except (TypeError, ValueError) as exc:\\r\\n            raise ValueError(\\\"Некорректная пагинация\\\") from exc\\r\\n        if page < 1 or page_size < 1 or page_size > 100:\\r\\n            raise ValueError(\\\"Страница от 1, размер страницы от 1 до 100\\\")\\r\\n        clauses, args = [], []\\r\\n        if public:\\r\\n            clauses.append(\\\"m.status='published'\\\")\\r\\n        else:\\r\\n            current = self._actor(actor)\\r\\n            if not current:\\r\\n                raise PermissionError(\\\"Требуется вход\\\")\\r\\n            if current[\\\"role\\\"] == \\\"author\\\":\\r\\n                clauses.append(\\\"m.author_id=?\\\")\\r\\n                args.append(current[\\\"id\\\"])\\r\\n        for key, value in [(\\\"type\\\", type_name), (\\\"status\\\", status)]:\\r\\n            if value:\\r\\n                clauses.append(f\\\"m.{key}=?\\\")\\r\\n                args.append(value)\\r\\n        for kind, value in [(\\\"category\\\", category), (\\\"tag\\\", tag)]:\\r\\n            if value:\\r\\n                clauses.append(\\\"EXISTS(SELECT 1 FROM material_terms mt JOIN terms t ON t.id=mt.term_id \\\"\\r\\n                               \\\"WHERE mt.material_id=m.id AND t.kind=? AND t.name=?)\\\")\\r\\n                args.extend([kind, value])\\r\\n        if q:\\r\\n            clauses.append(\\\"(m.title LIKE ? ESCAPE '\\\\\\\\' OR m.body LIKE ? ESCAPE '\\\\\\\\')\\\")\\r\\n            escaped = str(q).replace(\\\"\\\\\\\\\\\", \\\"\\\\\\\\\\\\\\\\\\\").replace(\\\"%\\\", \\\"\\\\\\\\%\\\").replace(\\\"_\\\", \\\"\\\\\\\\_\\\")\\r\\n            args.extend([f\\\"%{escaped}%\\\"] * 2)\\r\\n        where = \\\" WHERE \\\" + \\\" AND \\\".join(clauses) if clauses else \\\"\\\"\\r\\n        total = self.conn.execute(\\\"SELECT count(*) FROM materials m\\\" + where, args).fetchone()[0]\\r\\n        rows = self.conn.execute(\\r\\n            \\\"SELECT m.*,u.username AS author_name FROM materials m JOIN users u ON u.id=m.author_id\\\" + where\\r\\n            + \\\" ORDER BY m.published_at DESC,m.id DESC LIMIT ? OFFSET ?\\\", args + [page_size, (page - 1) * page_size]\\r\\n        ).fetchall()\\r\\n        return {\\\"items\\\": [self._material(r) for r in rows], \\\"total\\\": total, \\\"page\\\": page,\\r\\n                \\\"page_size\\\": page_size, \\\"pages\\\": (total + page_size - 1) // page_size}\\r\\n\\r\\n    def _audit(self, actor, operation, material_id, detail):\\r\\n\\\"\\\"\\\"Project lint and tests, executable with only the Python standard library.\\\"\\\"\\\"\\r\\nfrom pathlib import Path\\r\\nimport ast\\r\\nimport subprocess\\r\\nimport sys\\r\\n\\r\\nROOT = Path(__file__).resolve().parents[1]\\r\\n\\r\\n\\r\\ndef lint():\\r\\n    problems = []\\r\\n    for path in ROOT.rglob('*.py'):\\r\\n        if any(part in {'.venv', 'tmp', 'data', '__pycache__'} for part in path.relative_to(ROOT).parts):\\r\\n            continue\\r\\n        source = path.read_text(encoding='utf-8-sig')\\r\\n        for number, line in enumerate(source.splitlines(), 1):\\r\\n            if line.rstrip() != line:\\r\\n                problems.append(f'{path.relative_to(ROOT)}:{number}: trailing whitespace')\\r\\n            if '\\\\t' in line[:len(line) - len(line.lstrip())]:\\r\\n                problems.append(f'{path.relative_to(ROOT)}:{number}: tab indentation')\\r\\n        try:\\r\\n            tree = ast.parse(source, filename=str(path))\\r\\n        except SyntaxError as error:\\r\\n            problems.append(str(error))\\r\\n            continue\\r\\n        for node in ast.walk(tree):\\r\\n            if isinstance(node, ast.ExceptHandler) and node.type is None:\\r\\n                problems.append(f'{path.name}:{node.lineno}: bare except')\\r\\n            if isinstance(node, ast.ImportFrom) and any(v.name == '*' for v in node.names):\\r\\n                problems.append(f'{path.name}:{node.lineno}: wildcard import')\\r\\n            if isinstance(node, ast.Call) and isinstance(node.func, ast.Name) and node.func.id in {'eval', 'exec'}:\\r\\n                problems.append(f'{path.name}:{node.lineno}: dynamic code execution')\\r\\n            if isinstance(node, ast.Call) and any(k.arg == 'shell' and isinstance(k.value, ast.Constant)\\r\\n                                                   and k.value.value is True for k in node.keywords):\\r\\n                problems.append(f'{path.name}:{node.lineno}: shell execution')\\r\\n    for problem in problems:\\r\\n        print(problem)\\r\\n    print(f'Project lint: {len(problems)} issue(s)')\\r\\n    return not problems\\r\\n\\r\\n\\r\\nif __name__ == '__main__':\\r\\n    if not lint():\\r\\n        sys.exit(1)\\r\\n    sys.exit(subprocess.run([sys.executable, '-m', 'unittest', 'discover', '-s', 'tests', '-v'],\\r\\n                            cwd=ROOT, check=False).returncode)\\r\\n<a class=\\\"back\\\" href=\\\"/admin\\\">← Все материалы</a><div class=\\\"admin-heading\\\"><div><p class=\\\"eyebrow\\\">{{ type_label }} · {{ state }}</p><h1>Редактор материала</h1></div></div><div class=\\\"editor-layout\\\"><form class=\\\"editor\\\" method=\\\"post\\\"><input type=\\\"hidden\\\" name=\\\"csrf\\\" value=\\\"{{ csrf }}\\\"><label>Заголовок<input name=\\\"title\\\" value=\\\"{{ title }}\\\" maxlength=\\\"200\\\" required></label><label>Адрес страницы<input name=\\\"slug\\\" value=\\\"{{ slug }}\\\" placeholder=\\\"nazvanie-materiala\\\" required></label><label>Текст материала<textarea name=\\\"body\\\" rows=\\\"11\\\" required>{{ body }}</textarea></label><div class=\\\"form-row\\\"><label>Категория<input name=\\\"category\\\" value=\\\"{{ category }}\\\" required></label><label>Теги через запятую<input name=\\\"tags\\\" value=\\\"{{ tags }}\\\"></label></div><label>Описание для поисковых систем<textarea name=\\\"description\\\" rows=\\\"3\\\" maxlength=\\\"500\\\">{{ description }}</textarea></label>{{ fields }}<button class=\\\"button\\\">Сохранить изменения →</button></form><aside class=\\\"editor-sidebar\\\"><section><h2>Жизненный цикл</h2><p class=\\\"small\\\">Переходы проверяются ядром с учётом роли и текущего состояния.</p>{{ transitions }}</section><section><h2>История версий</h2><p class=\\\"small\\\">Восстановление создаёт новую ревизию.</p>{{ revisions }}</section><form method=\\\"post\\\" action=\\\"/admin/delete/{{ id }}\\\"><input type=\\\"hidden\\\" name=\\\"csrf\\\" value=\\\"{{ csrf }}\\\"><button class=\\\"text-button danger\\\">Удалить материал</button></form></aside></div>\\r\\n<tr><td>{{ time }}</td><td>{{ user }}</td><td>{{ action }}</td><td>{{ target }}</td></tr>\\r\\n<a class=\\\"back\\\" href=\\\"/admin\\\">← Материалы</a><section class=\\\"login-panel\\\"><p class=\\\"eyebrow\\\">МЕДИАБИБЛИОТЕКА</p><h1>Загрузить изображение</h1><p>PNG, JPEG или WebP. Система проверит содержимое и создаст производные размеры.</p><form method=\\\"post\\\" enctype=\\\"multipart/form-data\\\"><input type=\\\"hidden\\\" name=\\\"csrf\\\" value=\\\"{{ csrf }}\\\"><label>Изображение<input type=\\\"file\\\" name=\\\"image\\\" accept=\\\"image/png,image/jpeg,image/webp\\\" required></label><button class=\\\"button\\\">Загрузить</button></form><pre>{{ message }}</pre></section>\\r\\n\\r\\n    Directory: <PROFILE>\\\\Desktop\\\\магистратура\\\\Автоматизация проектирования интернет-приложений\\\\cms\\\\tests\\r\\n\\r\\nMode                 LastWriteTime         Length Name\\r\\n----                 -------------         ------ ----\\r\\nd----          15.11.2026    22:49                __pycache__\\r\\n-a---          15.11.2026    22:48          16424 test_core.py\\r\\n-a---          15.11.2026    22:46           1639 test_harness.py\\r\\n\\r\\n\"}]", "event_id": "audit-00038"}
{"timestamp": "2026-11-15T19:49:22.209Z", "kind": "custom_tool_call", "call_id": "C0015", "name": "exec", "namespace": "", "input": "const rs=await Promise.allSettled([\ntools.exec_command({cmd:\"@'\\nimport sys\\nsys.stdout.reconfigure(encoding='utf-8')\\nfrom docx import Document\\nfrom pathlib import Path\\np=Path.cwd().parent/'Автоматизация проектирования интернет-приложений'/'ЛР'/'ЛРагентнаяразработкасобственнойCMS.docx'\\nd=Document(p)\\nfor para in d.paragraphs:\\n if para.text.strip(): print(para.text)\\nfor t in d.tables:\\n print([[c.text for c in row.cells] for row in t.rows])\\n'@ | & 'C:\\\\Program Files\\\\WindowsApps\\\\OpenAI.CodexPrimaryRuntime.v26-1111-570-0_26.1111.570.0_x64__3k8sg7r9htsxt\\\\dependencies\\\\python\\\\python.exe' -\",\"max_output_tokens\":9000}),\ntools.exec_command({cmd:\"Get-Content -LiteralPath '..\\\\Автоматизация проектирования интернет-приложений\\\\cms\\\\tests\\\\test_core.py'\",\"max_output_tokens\":15000})\n]);for(let i=0;i<rs.length;i++)text({i,...rs[i]});\n", "event_id": "audit-00039"}
{"timestamp": "2026-11-15T19:49:23.179Z", "kind": "custom_tool_call_output", "call_id": "C0015", "output": "[{\"type\": \"input_text\", \"text\": \"Script completed\\nWall time 1.0 seconds\\nOutput:\\n\"}, {\"type\": \"input_text\", \"text\": \"{\\\"i\\\":0,\\\"status\\\":\\\"fulfilled\\\",\\\"value\\\":{\\\"chunk_id\\\":\\\"ce5fbd\\\",\\\"wall_time_seconds\\\":0.7462132,\\\"exit_code\\\":0,\\\"original_token_count\\\":4893,\\\"output\\\":\\\"Лабораторная работа № 1 (сквозная, на семестр)\\\\r\\\\n«Агентная разработка собственной системы управления контентом»\\\\r\\\\n1. Цель работы\\\\r\\\\nРабота выполняется в течение всего семестра. Ее результат — собственная небольшая, но настоящая система управления контентом (CMS): работающая, расширяемая, развернутая на стенде. Код CMS генерируется ИИ-агентом по спецификациям студента, и в этом смысл работы: объем проектируемой системы заведомо избыточен для ручного кодирования в отведенное время, поэтому студент учится управлять агентной разработкой — ставить задачи, делить их на порции, принимать и отклонять результаты, верифицировать генерацию.\\\\r\\\\nГотовые CMS в работе не используются вообще: WordPress и его собратья — предмет теории, а не инструмент. Студент строит систему того же класса своими руками, руками агента.\\\\r\\\\nЦель — освоить автоматизацию проектирования интернет-приложения на примере собственной CMS: спроектировать контент-модель и архитектуру, делегировать агенту реализацию ядра, панели администрирования, шаблонного слоя и аналитического модуля и довести систему до релиза.\\\\r\\\\n2. Инструменты и подготовка\\\\r\\\\nЯзык и веб-фреймворк по выбору, согласованные с преподавателем: Python (FastAPI, Flask, Django как набор библиотек), PHP (Laravel, Symfony), JavaScript/TypeScript (Express, NestJS, Fastify), Go, Ruby on Rails и др. Фреймворк задает каркас (роутинг, работа с HTTP), но не заменяет обязательные этапы работы.\\\\r\\\\nСУБД: SQLite для стенда (PostgreSQL по желанию), механизм миграций обязателен.\\\\r\\\\nИИ-агент с настроенным харнессом из сквозной практической работы; обе работы ведутся в едином репозитории.\\\\r\\\\nСредства контроля качества: тестовый фреймворк и линтер для выбранного стека; CI-конфигурация (GitHub Actions, GitLab CI или аналог) — по желанию, на оценку влияет только работоспособность проверок.\\\\r\\\\n3. Что считается собственной CMS\\\\r\\\\nЯдро системы — контент-модель, хранение, административный интерфейс, шаблонный слой — пишется в проекте. Сторонние библиотеки допускаются для вспомогательных задач (валидация, работа с изображениями), но не как замена обязательных этапов.\\\\r\\\\nЗапрещены: установка готовых CMS и использование встроенных автоадминок фреймворка (django-admin и аналоги) вместо этапа 3.\\\\r\\\\nКритерий на защите: студент объясняет любую строку кода и выполняет по заданию преподавателя небольшое изменение в системе силами агента в живой сессии.\\\\r\\\\n4. Общие требования к агентному выполнению\\\\r\\\\nКод решения генерируется ИИ-агентом (терминальный или IDE-агент из вашей практической работы) по спецификациям, которые вы пишете до генерации. Спецификации хранятся в каталоге spec/ и прикладываются к сдаче.\\\\r\\\\nВы самостоятельно выполняете декомпозицию, формулируете задания для каждого этапа и принимаете решения: принять, доработать, отклонить. Работа, в которой агенту принадлежат решения, а не исполнение, не принимается.\\\\r\\\\nОбязательное ведение журнала применения ИИ по каждой итерации: инструмент; суть задания (промта); результат (принято / отклонено / исправлено); обоснование решения. Код без журнала не принимается.\\\\r\\\\nСдача — репозиторий Git: ветка main для рабочего состояния, ветки feature/… по этапам, осмысленные сообщения коммитов. Секреты только в .env.\\\\r\\\\nНа защите вы отвечаете на вопросы по любому фрагменту кода, любой спецификации и любой итерации из журнала. Неспособность объяснить фрагмент приравнивается к невыполнению соответствующего этапа.\\\\r\\\\n5. Задание\\\\r\\\\nРазработать собственную CMS для выбранной предметной области (медиа-издание, каталог организаций, учебный портал, доска объявлений, библиотечный фонд — тематика согласуется с преподавателем не позднее второго занятия).\\\\r\\\\nЭтап 1. Предметная область и каркас (3 ч, разделы 1–2)\\\\r\\\\nСпецификация контент-модели до генерации: не менее 4 типов материалов, таксономия (категории, теги), метаданные, жизненный цикл публикации (черновик → на модерации → опубликован → архив).\\\\r\\\\nАрхитектурная спецификация: слои приложения, хранилище, границы модулей; решения фиксируются в журнале проектных решений (ADR) — методика отработана в практической работе.\\\\r\\\\nКаркас приложения, сгенерированный агентом: структура каталогов, конфигурация, подключение БД, стартовые миграции; запуск стенда «одной командой» (скрипт или docker compose).\\\\r\\\\nТочки контроля: линтер и тестовый прогон подключены и выполняются.\\\\r\\\\nЭтап 2. Ядро управления контентом (4 ч, разделы 2–3)\\\\r\\\\nТипы материалов как конфигурация ядра, а не жестко зашитый код: новый тип добавляется схемой (описание полей, правила валидации) без правки ядра — шаблонно-ориентированный подход, который вы затем проверите на защите.\\\\r\\\\nСлой хранения: репозитории, миграции для каждой схемы; версионность материалов — ревизии с возможностью отката.\\\\r\\\\nТаксономия: категории и теги, связи материалов с терминами.\\\\r\\\\nМедиа: загрузка файлов, метаданные, производные размеры изображений.\\\\r\\\\nТесты ядра: инварианты контент-модели, round-trip сериализации материалов, откат ревизий — не менее 15.\\\\r\\\\nЭтап 3. Панель администрирования (4 ч, раздел 3)\\\\r\\\\nАутентификация и сессии; не менее трех ролей (администратор, редактор, автор) с матрицей прав на операции и типы материалов.\\\\r\\\\nИнтерфейс CRUD для всех типов материалов, модерация публикаций, журнал действий пользователей.\\\\r\\\\nСписки с фильтрацией и поиском, пакетные операции.\\\\r\\\\nТесты доступа: параметризованные проверки «роль → операция → разрешено/запрещено», не менее 10.\\\\r\\\\nЭтап 4. Шаблонный слой и публичная часть (4 ч, раздел 3)\\\\r\\\\nСобственный шаблонный механизм (или строго изолированный слой рендеринга): темы, partial-шаблоны, наследование; обязательное экранирование пользовательских данных, подтвержденное тестом на внедрение разметки.\\\\r\\\\nПубличные страницы: главная, разделы, страница материала, навигационное меню, собираемое из контент-модели.\\\\r\\\\nREST API в headless-режиме: выдача материалов в JSON с пагинацией и фильтрацией по таксономии.\\\\r\\\\nБазовая оптимизация под поисковые системы: человекочитаемые адреса, метатеги из модели, sitemap.xml, robots.txt.\\\\r\\\\nСквозные (end-to-end) тесты публичной части — не менее 3 сценариев.\\\\r\\\\nЭтап 5. Аналитический модуль и релиз (2 ч, раздел 4)\\\\r\\\\nВстроенный сбор метрик самой веб-системы: просмотры материалов, публикации по периодам, активность авторов.\\\\r\\\\nОбработка метрик средствами вашей системы: агрегаты, экран статистики для администратора.\\\\r\\\\nРелиз v1.0: CHANGELOG, инструкция развертывания «с нуля», демонстрация преподавателю на стенде.\\\\r\\\\n6. Структура отчета\\\\r\\\\nОтчет оформляется по ГОСТ 7.32-2017 (правила оформления текстовых документов ГУАП: https://guap.ru/standart/doc) и включает:\\\\r\\\\nТитульный лист.\\\\r\\\\nЗадание на выполнение работы (предметная область, стек, этапы).\\\\r\\\\nПорядок выполнения работы по этапам; текстовая часть дополняется экранами работающей системы и фрагментами сгенерированного кода с вашими пояснениями.\\\\r\\\\nАгентский харнесс: состав и пример настройки (файл правил, разрешающая модель, собственные команды, журналирование), изменения за семестр и их причины — в связке с практической работой.\\\\r\\\\nВыводы о проделанной работе в формате эссе: что агент выполнил хорошо, где ошибался, какие решения остались за вами.\\\\r\\\\nСписок использованных источников.\\\\r\\\\nПриложения: спецификации этапов; журнал применения ИИ; аннотированная трасса агентской сессии со ссылкой на полный экспорт в репозитории (каталог traces/).\\\\r\\\\n7. Условия приема работы\\\\r\\\\nОценка выставляется по наименьшему выполненному уровню по строкам таблицы (все условия уровня должны быть выполнены полностью).\\\\r\\\\n8. Контрольные вопросы\\\\r\\\\nНазначение систем управления контентом. Теперь, когда вы писали ядро сами, где проходит граница между CMS и фреймворком?\\\\r\\\\nЧто входит в контент-модель вашей системы и почему новые типы материалов стоит добавлять конфигурацией, а не правкой кода ядра?\\\\r\\\\nЖизненный цикл публикации: какие состояния и переходы вы выделили и где контролируются права на переходы?\\\\r\\\\nКак хранятся ревизии материалов и чем версионность в базе отличается от версионности в Git?\\\\r\\\\nКак устроена таксономия вашей системы? Где связь «материал — термин» enforced: в ядре, в БД или в приложении?\\\\r\\\\nКакие роли нужны вашей системе и по какому принципу построена матрица прав?\\\\r\\\\nКак шаблонный слой экранирует пользовательские данные? Что произойдет при выводе материала с разметкой в поле заголовка?\\\\r\\\\nОткуда берутся человекочитаемые адреса и метатеги страниц в вашей системе?\\\\r\\\\nЧто дает headless-режим с REST API и когда серверный рендеринг предпочтительнее?\\\\r\\\\nКакие метрики собирает ваш аналитический модуль и как агрегация выполняется средствами самой веб-системы?\\\\r\\\\nЧто в системе сгенерировал агент, а что написали или исправили вы? Какое решение вы не смогли делегировать и почему?\\\\r\\\\nКак качество спецификации повлияло на качество генерации? Покажите промпт «до» и «после».\\\\r\\\\nКак разрешающая модель харнесса защитила проект от ошибок агента? Приведите эпизод из трассы.\\\\r\\\\nПриведите пример галлюцинации агента (в коде, миграции или шаблоне). Как она выявлена — тестом или ревью — и как исправлена?\\\\r\\\\nСколько мест в системе придется изменить, чтобы добавить новый тип материала и новую роль? Как вы уменьшали это число?\\\\r\\\\n[['Критерий', 'На «3»', 'На «4»', 'На «5»'], ['Каркас и архитектура', 'Стенд запускается одной командой; специфицированы не менее 3 типов материалов; контент-модель описана', 'Не менее 4 типов с жизненным циклом; миграции автоматические; линтер и тесты выполняются одной командой', 'Новый тип материала добавляется конфигурацией без правки ядра — проверяется на защите; архитектура обоснована в ADR с отклоненными альтернативами'], ['Ядро контента', 'Хранение всех типов, таксономия работает', 'Ревизии с откатом, медиа с производными размерами; не менее 15 тестов ядра', 'Не менее 25 тестов, включая round-trip и инварианты; генерация ядра шла порциями по спецификации (видно по журналу и трассам)'], ['Панель администрирования', 'Вход, CRUD всех типов материалов', 'Не менее 3 ролей с матрицей прав, модерация, журнал действий; не менее 10 тестов доступа', 'Плюс пакетные операции и фильтры; сквозной тест сценария администратора; на защите добавлена роль или право живой агентной сессией'], ['Шаблонный слой и публичная часть', 'Тема для публичных страниц, меню, страницы материалов', 'Наследование и partial-шаблоны; экранирование подтверждено тестом на внедрение; REST API с пагинацией', 'Плюс вторая тема; метатеги, sitemap, robots; не менее 3 end-to-end сценариев'], ['Аналитика и релиз', 'Просмотры собираются, экран статистики есть', 'Агрегаты по периодам и авторам; релиз v1.0 с CHANGELOG и инструкцией развертывания', 'Плюс развертывание «с нуля» продемонстрировано; выбор метрик обоснован'], ['Работа с агентом', 'Журнал ИИ не менее 8 итераций; не менее 1 трассы сессии', 'Журнал не менее 15 итераций; трассы не менее чем 3 этапов; не менее 5 отклоненных предложений с разбором', 'Журнал не менее 25 итераций; трассы по всем этапам; разбор промптов «до/после»; метрики (сгенерировано / принято / переработано)'], ['Отчет и защита', 'Структура отчета соблюдена; ответы на базовые вопросы', 'Раздел «Агентский харнесс» с примером настройки; эссе-выводы; уверенные ответы по журналу и трассе', 'Плюс живая мини-сессия с агентом на защите; разбор ошибок агента и своих решений']]\\\\r\\\\n\\\"}}\"}, {\"type\": \"input_text\", \"text\": \"{\\\"i\\\":1,\\\"status\\\":\\\"fulfilled\\\",\\\"value\\\":{\\\"chunk_id\\\":\\\"2d1ea0\\\",\\\"wall_time_seconds\\\":0.405215,\\\"exit_code\\\":0,\\\"original_token_count\\\":4189,\\\"output\\\":\\\"\\\\\\\"\\\\\\\"\\\\\\\"Core invariants exercised against real temporary SQLite databases.\\\\\\\"\\\\\\\"\\\\\\\"\\\\r\\\\n\\\\r\\\\nfrom io import BytesIO\\\\r\\\\nimport json\\\\r\\\\nfrom pathlib import Path\\\\r\\\\nimport shutil\\\\r\\\\nimport sqlite3\\\\r\\\\nimport tempfile\\\\r\\\\nimport unittest\\\\r\\\\n\\\\r\\\\nfrom PIL import Image\\\\r\\\\n\\\\r\\\\nfrom core import CMS\\\\r\\\\n\\\\r\\\\n\\\\r\\\\nclass CoreTests(unittest.TestCase):\\\\r\\\\n    def setUp(self):\\\\r\\\\n        self.temp = tempfile.TemporaryDirectory()\\\\r\\\\n        self.root = Path(self.temp.name)\\\\r\\\\n        self.cms = CMS(self.root)\\\\r\\\\n        self.admin = self.cms.create_user(\\\\\\\"admin\\\\\\\", \\\\\\\"<TEST_PASSWORD>\\\\\\\", \\\\\\\"admin\\\\\\\")\\\\r\\\\n        self.editor = self.cms.create_user(\\\\\\\"editor\\\\\\\", \\\\\\\"<TEST_PASSWORD>\\\\\\\", \\\\\\\"editor\\\\\\\", self.admin)\\\\r\\\\n        self.author = self.cms.create_user(\\\\\\\"author\\\\\\\", \\\\\\\"<TEST_PASSWORD>\\\\\\\", \\\\\\\"author\\\\\\\", self.admin)\\\\r\\\\n\\\\r\\\\n    def tearDown(self):\\\\r\\\\n        self.cms.close()\\\\r\\\\n        self.temp.cleanup()\\\\r\\\\n\\\\r\\\\n    def data(self, slug=\\\\\\\"sample\\\\\\\", **changes):\\\\r\\\\n        data = {\\\\\\\"type\\\\\\\": \\\\\\\"news\\\\\\\", \\\\\\\"title\\\\\\\": \\\\\\\"Учебная новость\\\\\\\", \\\\\\\"slug\\\\\\\": slug, \\\\\\\"body\\\\\\\": \\\\\\\"Текст\\\\\\\",\\\\r\\\\n                \\\\\\\"description\\\\\\\": \\\\\\\"Описание\\\\\\\", \\\\\\\"category\\\\\\\": \\\\\\\"Учеба\\\\\\\", \\\\\\\"tags\\\\\\\": [\\\\\\\"веб\\\\\\\", \\\\\\\"python\\\\\\\"],\\\\r\\\\n                \\\\\\\"fields\\\\\\\": {\\\\\\\"lead\\\\\\\": \\\\\\\"Анонс\\\\\\\"}}\\\\r\\\\n        data.update(changes)\\\\r\\\\n        return data\\\\r\\\\n\\\\r\\\\n    def item(self, **changes):\\\\r\\\\n        return self.cms.create(self.data(**changes), self.author)\\\\r\\\\n\\\\r\\\\n    def publish(self, item):\\\\r\\\\n        self.cms.transition(item[\\\\\\\"id\\\\\\\"], \\\\\\\"review\\\\\\\", self.author)\\\\r\\\\n        return self.cms.transition(item[\\\\\\\"id\\\\\\\"], \\\\\\\"published\\\\\\\", self.editor)\\\\r\\\\n\\\\r\\\\n    def test_01_migrations_are_idempotent(self):\\\\r\\\\n        self.cms.migrate()\\\\r\\\\n        self.cms.migrate()\\\\r\\\\n        names = [r[0] for r in self.cms.conn.execute(\\\\\\\"SELECT name FROM migrations ORDER BY name\\\\\\\")]\\\\r\\\\n        self.assertEqual(names, [\\\\\\\"001_core.sql\\\\\\\", \\\\\\\"002_indexes.sql\\\\\\\"])\\\\r\\\\n\\\\r\\\\n    def test_02_four_types_loaded(self):\\\\r\\\\n        self.assertEqual(set(self.cms.schemas), {\\\\\\\"news\\\\\\\", \\\\\\\"course\\\\\\\", \\\\\\\"event\\\\\\\", \\\\\\\"resource\\\\\\\"})\\\\r\\\\n\\\\r\\\\n    def test_03_round_trip_preserves_unicode_and_taxonomy(self):\\\\r\\\\n        item = self.item()\\\\r\\\\n        read = self.cms.get(item[\\\\\\\"id\\\\\\\"])\\\\r\\\\n        for name in self.data():\\\\r\\\\n            self.assertEqual(read[name], self.data()[name])\\\\r\\\\n\\\\r\\\\n    def test_04_round_trip_every_content_type(self):\\\\r\\\\n        fields = {\\\\\\\"news\\\\\\\": {\\\\\\\"lead\\\\\\\": \\\\\\\"Анонс\\\\\\\"}, \\\\\\\"course\\\\\\\": {\\\\\\\"teacher\\\\\\\": \\\\\\\"Иванов\\\\\\\", \\\\\\\"hours\\\\\\\": 72},\\\\r\\\\n                  \\\\\\\"event\\\\\\\": {\\\\\\\"date\\\\\\\": \\\\\\\"2026-12-01\\\\\\\", \\\\\\\"location\\\\\\\": \\\\\\\"Онлайн\\\\\\\"},\\\\r\\\\n                  \\\\\\\"resource\\\\\\\": {\\\\\\\"url\\\\\\\": \\\\\\\"https://example.org/lesson\\\\\\\", \\\\\\\"format\\\\\\\": \\\\\\\"PDF\\\\\\\"}}\\\\r\\\\n        for kind, values in fields.items():\\\\r\\\\n            with self.subTest(kind=kind):\\\\r\\\\n                item = self.item(slug=kind, type=kind, fields=values)\\\\r\\\\n                self.assertEqual(self.cms.get(kind)[\\\\\\\"fields\\\\\\\"], values)\\\\r\\\\n                self.assertEqual(item[\\\\\\\"status\\\\\\\"], \\\\\\\"draft\\\\\\\")\\\\r\\\\n\\\\r\\\\n    def test_05_required_field(self):\\\\r\\\\n        with self.assertRaises(ValueError):\\\\r\\\\n            self.item(fields={})\\\\r\\\\n\\\\r\\\\n    def test_06_unknown_field_rejected(self):\\\\r\\\\n        with self.assertRaises(ValueError):\\\\r\\\\n            self.item(fields={\\\\\\\"lead\\\\\\\": \\\\\\\"a\\\\\\\", \\\\\\\"unexpected\\\\\\\": \\\\\\\"b\\\\\\\"})\\\\r\\\\n\\\\r\\\\n    def test_07_unknown_top_level_field_rejected(self):\\\\r\\\\n        with self.assertRaises(ValueError):\\\\r\\\\n            self.item(author_id=self.admin[\\\\\\\"id\\\\\\\"])\\\\r\\\\n\\\\r\\\\n    def test_08_integer_validation(self):\\\\r\\\\n        for value in [True, \\\\\\\"72\\\\\\\", 0, 1001, 1.5]:\\\\r\\\\n            with self.subTest(value=value), self.assertRaises(ValueError):\\\\r\\\\n                self.item(type=\\\\\\\"course\\\\\\\", fields={\\\\\\\"teacher\\\\\\\": \\\\\\\"Teacher\\\\\\\", \\\\\\\"hours\\\\\\\": value})\\\\r\\\\n\\\\r\\\\n    def test_09_date_validation(self):\\\\r\\\\n        with self.assertRaises(ValueError):\\\\r\\\\n            self.item(type=\\\\\\\"event\\\\\\\", fields={\\\\\\\"date\\\\\\\": \\\\\\\"2026-02-30\\\\\\\", \\\\\\\"location\\\\\\\": \\\\\\\"Here\\\\\\\"})\\\\r\\\\n\\\\r\\\\n    def test_10_unsafe_url_rejected(self):\\\\r\\\\n        for value in [\\\\\\\"javascript:alert(1)\\\\\\\", \\\\\\\"//example.org\\\\\\\", \\\\\\\"file:///etc/passwd\\\\\\\", \\\\\\\"https://\\\\\\\"]:\\\\r\\\\n            with self.subTest(value=value), self.assertRaises(ValueError):\\\\r\\\\n                self.item(type=\\\\\\\"resource\\\\\\\", fields={\\\\\\\"url\\\\\\\": value, \\\\\\\"format\\\\\\\": \\\\\\\"Link\\\\\\\"})\\\\r\\\\n\\\\r\\\\n    def test_11_duplicate_slug_does_not_create_partial_data(self):\\\\r\\\\n        item = self.item()\\\\r\\\\n        before = self.cms.conn.execute(\\\\\\\"SELECT count(*) FROM revisions\\\\\\\").fetchone()[0]\\\\r\\\\n        with self.assertRaises(ValueError):\\\\r\\\\n            self.item(title=\\\\\\\"Другой\\\\\\\", category=\\\\\\\"Новая\\\\\\\")\\\\r\\\\n        self.assertEqual(self.cms.conn.execute(\\\\\\\"SELECT count(*) FROM materials\\\\\\\").fetchone()[0], 1)\\\\r\\\\n        self.assertEqual(self.cms.conn.execute(\\\\\\\"SELECT count(*) FROM revisions\\\\\\\").fetchone()[0], before)\\\\r\\\\n        self.assertEqual(self.cms.get(item[\\\\\\\"id\\\\\\\"])[\\\\\\\"category\\\\\\\"], \\\\\\\"Учеба\\\\\\\")\\\\r\\\\n\\\\r\\\\n    def test_12_slug_validation(self):\\\\r\\\\n        for slug in [\\\\\\\"../etc\\\\\\\", \\\\\\\"MixedCase\\\\\\\", \\\\\\\"привет\\\\\\\", \\\\\\\"two--dashes\\\\\\\", \\\\\\\"a/b\\\\\\\", \\\\\\\"\\\\\\\"]:\\\\r\\\\n            with self.subTest(slug=slug), self.assertRaises(ValueError):\\\\r\\\\n                self.item(slug=slug)\\\\r\\\\n\\\\r\\\\n    def test_13_invalid_lifecycle_cannot_skip_moderation(self):\\\\r\\\\n        item = self.item()\\\\r\\\\n        with self.assertRaises(ValueError):\\\\r\\\\n            self.cms.transition(item[\\\\\\\"id\\\\\\\"], \\\\\\\"published\\\\\\\", self.admin)\\\\r\\\\n        self.assertEqual(self.cms.get(item[\\\\\\\"id\\\\\\\"])[\\\\\\\"status\\\\\\\"], \\\\\\\"draft\\\\\\\")\\\\r\\\\n\\\\r\\\\n    def test_14_author_cannot_publish(self):\\\\r\\\\n        item = self.item()\\\\r\\\\n        self.cms.transition(item[\\\\\\\"id\\\\\\\"], \\\\\\\"review\\\\\\\", self.author)\\\\r\\\\n        with self.assertRaises(PermissionError):\\\\r\\\\n            self.cms.transition(item[\\\\\\\"id\\\\\\\"], \\\\\\\"published\\\\\\\", self.author)\\\\r\\\\n\\\\r\\\\n    def test_15_lifecycle_through_archive(self):\\\\r\\\\n        item = self.publish(self.item())\\\\r\\\\n        self.assertIsNotNone(item[\\\\\\\"published_at\\\\\\\"])\\\\r\\\\n        self.cms.transition(item[\\\\\\\"id\\\\\\\"], \\\\\\\"archived\\\\\\\", self.editor)\\\\r\\\\n        self.assertIsNone(self.cms.get(item[\\\\\\\"slug\\\\\\\"], public=True))\\\\r\\\\n        self.cms.transition(item[\\\\\\\"id\\\\\\\"], \\\\\\\"draft\\\\\\\", self.editor)\\\\r\\\\n        self.assertEqual(self.cms.get(item[\\\\\\\"id\\\\\\\"])[\\\\\\\"revision\\\\\\\"], 5)\\\\r\\\\n\\\\r\\\\n    def test_16_update_creates_immutable_revision(self):\\\\r\\\\n        item = self.item()\\\\r\\\\n        self.cms.update(item[\\\\\\\"id\\\\\\\"], {\\\\\\\"title\\\\\\\": \\\\\\\"Новая версия\\\\\\\"}, self.author)\\\\r\\\\n        revisions = self.cms.revisions(item[\\\\\\\"id\\\\\\\"], self.author)\\\\r\\\\n        self.assertEqual([r[\\\\\\\"number\\\\\\\"] for r in revisions], [2, 1])\\\\r\\\\n        self.assertEqual(revisions[-1][\\\\\\\"snapshot\\\\\\\"][\\\\\\\"title\\\\\\\"], \\\\\\\"Учебная новость\\\\\\\")\\\\r\\\\n\\\\r\\\\n    def test_17_restore_creates_new_revision_and_draft(self):\\\\r\\\\n        item = self.item()\\\\r\\\\n        revision = self.cms.revisions(item[\\\\\\\"id\\\\\\\"], self.author)[0]\\\\r\\\\n        self.cms.update(item[\\\\\\\"id\\\\\\\"], {\\\\\\\"title\\\\\\\": \\\\\\\"Вторая\\\\\\\", \\\\\\\"tags\\\\\\\": [\\\\\\\"тест\\\\\\\"]}, self.author)\\\\r\\\\n        self.publish(item)\\\\r\\\\n        restored = self.cms.restore(item[\\\\\\\"id\\\\\\\"], revision[\\\\\\\"id\\\\\\\"], self.admin)\\\\r\\\\n        self.assertEqual(restored[\\\\\\\"title\\\\\\\"], item[\\\\\\\"title\\\\\\\"])\\\\r\\\\n        self.assertEqual(restored[\\\\\\\"tags\\\\\\\"], item[\\\\\\\"tags\\\\\\\"])\\\\r\\\\n        self.assertEqual(restored[\\\\\\\"status\\\\\\\"], \\\\\\\"draft\\\\\\\")\\\\r\\\\n        self.assertEqual(restored[\\\\\\\"author_id\\\\\\\"], self.author[\\\\\\\"id\\\\\\\"])\\\\r\\\\n        self.assertEqual(restored[\\\\\\\"revision\\\\\\\"], 5)\\\\r\\\\n\\\\r\\\\n    def test_18_cannot_restore_other_material_revision(self):\\\\r\\\\n        first = self.item()\\\\r\\\\n        second = self.item(slug=\\\\\\\"second\\\\\\\")\\\\r\\\\n        foreign = self.cms.revisions(second[\\\\\\\"id\\\\\\\"], self.author)[0]\\\\r\\\\n        with self.assertRaises(LookupError):\\\\r\\\\n            self.cms.restore(first[\\\\\\\"id\\\\\\\"], foreign[\\\\\\\"id\\\\\\\"], self.author)\\\\r\\\\n\\\\r\\\\n    def test_19_foreign_keys_reject_orphan_taxonomy(self):\\\\r\\\\n        with self.assertRaises(sqlite3.IntegrityError), self.cms.conn:\\\\r\\\\n            self.cms.conn.execute(\\\\\\\"INSERT INTO material_terms VALUES(999,999)\\\\\\\")\\\\r\\\\n\\\\r\\\\n    def test_20_taxonomy_filters_and_tag_deduplication(self):\\\\r\\\\n        item = self.item(tags=[\\\\\\\"python\\\\\\\", \\\\\\\"python\\\\\\\", \\\\\\\"веб\\\\\\\"])\\\\r\\\\n        self.publish(item)\\\\r\\\\n        self.assertEqual(self.cms.list(tag=\\\\\\\"python\\\\\\\")[\\\\\\\"total\\\\\\\"], 1)\\\\r\\\\n        self.assertEqual(self.cms.list(category=\\\\\\\"Учеба\\\\\\\")[\\\\\\\"total\\\\\\\"], 1)\\\\r\\\\n        self.assertEqual(self.cms.list(tag=\\\\\\\"other\\\\\\\")[\\\\\\\"total\\\\\\\"], 0)\\\\r\\\\n        self.assertEqual(self.cms.get(item[\\\\\\\"id\\\\\\\"])[\\\\\\\"tags\\\\\\\"], [\\\\\\\"python\\\\\\\", \\\\\\\"веб\\\\\\\"])\\\\r\\\\n\\\\r\\\\n    def test_21_public_listing_never_leaks_draft(self):\\\\r\\\\n        self.item()\\\\r\\\\n        self.assertEqual(self.cms.list()[\\\\\\\"items\\\\\\\"], [])\\\\r\\\\n        self.assertEqual(self.cms.list(public=False, actor=self.author)[\\\\\\\"total\\\\\\\"], 1)\\\\r\\\\n\\\\r\\\\n    def test_22_search_uses_parameters_and_literal_wildcards(self):\\\\r\\\\n        self.publish(self.item(title=\\\\\\\"100% практики\\\\\\\"))\\\\r\\\\n        self.assertEqual(self.cms.list(q=\\\\\\\"%\\\\\\\")[\\\\\\\"total\\\\\\\"], 1)\\\\r\\\\n  